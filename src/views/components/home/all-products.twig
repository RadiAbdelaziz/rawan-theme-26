{% if component.products|length %}
    <section class="luxury-products-section reveal-section" style="--lux-bg: {{ component.background_color ?: '#ffffff' }}; --lux-accent: {{ component.accent_color ?: '#E62973' }}; --lux-card: {{ component.card_color ?: '#ffffff' }}; --lux-padding: {{ component.section_padding ?: 80 }}px;">
        <div class="container">
            {# -------------------------------------------------------------
               # SECTION HEADER: Title, Subtitle, Badge & Divider
               ------------------------------------------------------------- #}
            <header class="lux-header">
                {# Section Badge #}
                <div class="lux-badge">
                    <span class="lux-badge-dot"></span>
                    <span>{{ component.badge_text ?: 'منتجاتنا' }}</span>
                </div>

                {# Section Title #}
                <h2 class="lux-heading">{{ component.title ?: 'تصميم عصري يناسب جميع المناسبات' }}</h2>

                {# Section Subtitle #}
                <p class="lux-subheading">{{ component.subtitle ?: 'قطعة مختارة بعناية لتناسب كل المناسبات وتضفي لمسة أناقة على مظهرك اليومي' }}</p>

                {# Decorative Line #}
                <div class="lux-line">
                    <span></span>
                    <i></i>
                    <span></span>
                </div>
            </header>

            {# -------------------------------------------------------------
               # PRODUCTS CAROUSEL: Navigation & Product Grid
               ------------------------------------------------------------- #}
            <div class="lux-carousel" data-columns="{{ component.columns ?: '5' }}">
                {# Carousel Navigation: Previous Button #}
                <button type="button" class="lux-carousel-arrow lux-carousel-arrow--prev" aria-label="المنتجات السابقة">
                    <i class="sicon-keyboard-arrow-right"></i>
                </button>

                {# Carousel Viewport & Track #}
                <div class="lux-carousel-viewport">
                    <div class="lux-carousel-track">
                        {% for product in component.products %}
                            {# --- Product Card Item --- #}
                            <article class="lux-card" style="--product-index: {{ loop.index0 }};">
                                {# Product Image & Overlays #}
                                <div class="lux-image">
                                    {% if component.show_discount != false and product.promotion_title %}
                                        <span class="lux-discount">{{ product.promotion_title }}</span>
                                    {% endif %}

                                    <button type="button" class="lux-wishlist" aria-label="إضافة {{ product.name }} إلى المفضلة" onclick="salla.wishlist.toggle('{{ product.id }}')">
                                        <span>♡</span>
                                    </button>

                                    <a href="{{ product.url }}" class="lux-image-link" aria-label="{{ product.name }}">
                                        {% if product.image %}
                                            <img class="lux-product-image" src="{{ product.image.url ?: product.image }}" alt="{{ product.image.alt ?: product.name }}" loading="lazy">
                                        {% elseif product.main_image %}
                                            <img class="lux-product-image" src="{{ product.main_image }}" alt="{{ product.name }}" loading="lazy">
                                        {% else %}
                                            <img class="lux-product-image" src="{{ 'images/placeholder.png'|asset }}" alt="{{ product.name }}" loading="lazy">
                                        {% endif %}
                                    </a>
                                </div>

                                {# Product Availability Status #}
                                {% if product.is_out_of_stock %}
                                    <div class="lux-sales-status lux-sales-status--out">غير متوفر حالياً</div>
                                {% elseif product.promotion_title %}
                                    <div class="lux-sales-status">{{ product.promotion_title }}</div>
                                {% endif %}

                                {# Product Content Details #}
                                <div class="lux-content">
                                    {# Rating Badge #}
                                    {% if component.show_rating != false and product.rating %}
                                        <div class="lux-rating">
                                            <span class="lux-rating-star">★</span>
                                            <span class="lux-rating-value">{{ product.rating.stars ?: product.rating }}</span>
                                            {% if product.rating.count %}
                                                <span class="lux-rating-count">({{ product.rating.count }})</span>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {# Product Name #}
                                    <h3 class="lux-product-title">
                                        <a href="{{ product.url }}">{{ product.name }}</a>
                                    </h3>

                                    {# Product Subtitle / Brand #}
                                    <p class="lux-product-subinfo">
                                        {% if product.subtitle %}
                                            {{ product.subtitle }}
                                        {% elseif product.brand and product.brand.name %}
                                            {{ product.brand.name }}
                                        {% else %}
                                            منتج فاخر مختار بعناية
                                        {% endif %}
                                    </p>

                                    {# Pricing Information #}
                                    {% if component.show_price != false %}
                                        <div class="lux-price">
                                            {% if product.is_on_sale and product.sale_price %}
                                                <div class="lux-price-main">
                                                    <strong class="lux-price-current">{{ product.sale_price }}</strong>
                                                    <span class="lux-price-currency" aria-label="ريال سعودي"><i class="sicon-sar"></i></span>
                                                </div>
                                                {% if product.regular_price %}
                                                    <del class="lux-price-old">
                                                        <span>{{ product.regular_price }}</span>
                                                        <i class="sicon-sar"></i>
                                                    </del>
                                                {% endif %}
                                            {% else %}
                                                <div class="lux-price-main">
                                                    <strong class="lux-price-current">{{ product.price }}</strong>
                                                    <span class="lux-price-currency" aria-label="ريال سعودي"><i class="sicon-sar"></i></span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {# Add to Cart Action #}
                                    {% if component.show_add_button != false %}
                                        <div class="lux-cart">
                                            <salla-add-product-button product-id="{{ product.id }}" product-status="{{ product.status }}" product-type="{{ product.type }}" width="full">
                                                <span class="lux-cart-inner">
                                                    <i class="sicon-shopping-bag"></i>
                                                    <span>إضافة إلى السلة</span>
                                                </span>
                                            </salla-add-product-button>
                                        </div>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                </div>

                {# Carousel Navigation: Next Button #}
                <button type="button" class="lux-carousel-arrow lux-carousel-arrow--next" aria-label="المنتجات التالية">
                    <i class="sicon-keyboard-arrow-left"></i>
                </button>
            </div>
        </div>
    </section>
{% endif %}