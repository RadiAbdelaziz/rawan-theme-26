{# ----------------------------------------------------------------------
   Component: Cinematic Luxury Hero
   Description: Hero section featuring dynamic slideshow background from 1 to 3 images,
   embedded header navigation, localized actions, and CTA area.
   ---------------------------------------------------------------------- #}

{% if component.luxury_show_section != false %}
{% set images = [] %}
{% if component.luxury_image_1 %}{% set images = images|merge([component.luxury_image_1]) %}{% endif %}
{% if component.luxury_image_2 %}{% set images = images|merge([component.luxury_image_2]) %}{% endif %}
{% if component.luxury_image_3 %}{% set images = images|merge([component.luxury_image_3]) %}{% endif %}

<section
    class="luxury-overlay-hero cinematic-hero-slideshow"
    style="
        --luxury-overlay: {{ component.luxury_overlay_color ?: '#000000' }};
        --luxury-overlay-opacity: {{ component.luxury_overlay_opacity ?: '0.35' }};
        --luxury-title-color: {{ component.luxury_title_color ?: '#FFFFFF' }};
        --luxury-highlight-color: {{ component.luxury_highlight_color ?: '#E62973' }};
        --luxury-description-color: {{ component.luxury_description_color ?: '#FFFFFF' }};
        --luxury-accent: #E62973;
        min-height: {{ component.luxury_section_height ?: '100vh' }};
    "
    data-speed="{{ component.luxury_slide_speed ? component.luxury_slide_speed * 1000 : 4000 }}"
>
    {# Background Slideshow Media Handler #}
    <div class="hero-slides-container luxury-overlay-hero__video">
        {% if images|length > 0 %}
            {% for img in images %}
                <div class="hero-slide-item {{ loop.first ? 'active' : '' }}" style="background-image: url('{{ img }}');"></div>
            {% endfor %}
        {% else %}
            <div class="hero-slide-item active" style="background-image: url('{{ asset('images/banner.mp4') }}'); background-size: cover; background-position: center;"></div>
        {% endif %}
    </div>

    {# Visual Overlays & Effects #}
    <div class="luxury-overlay-hero__dark-overlay" aria-hidden="true"></div>
    <div class="luxury-overlay-hero__gradient" aria-hidden="true"></div>
    <div class="luxury-overlay-hero__glow luxury-overlay-hero__glow--left" aria-hidden="true"></div>
    <div class="luxury-overlay-hero__glow luxury-overlay-hero__glow--right" aria-hidden="true"></div>

    {# Header Navigation Container #}
    <header class="luxury-overlay-header" data-testid="luxury-overlay-header">
        <div class="luxury-overlay-header__top">
            {# Store Branding / Logo #}
            <div class="luxury-overlay-header__logo">
                <a href="{{ store.url }}" aria-label="{{ store.name }}">
                    <img
                        src="{{ asset('images/theme-logo.png') }}"
                        alt="{{ store.name }}"
                        class="luxury-overlay-header__logo-image"
                    >
                </a>
            </div>

            {# Header Controls: Search & Localization #}
            <div class="luxury-overlay-header__controls">
                {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                    <div class="luxury-overlay-header__localization">
                        <salla-localization-modal show-trigger></salla-localization-modal>
                    </div>
                {% endif %}

                <div class="luxury-overlay-header__search">
                    <salla-search inline oval height="40"></salla-search>
                </div>
            </div>

            {# User Interaction Links #}
            <div class="luxury-overlay-header__actions">
                <div class="luxury-overlay-header__action luxury-overlay-header__user">
                    <salla-user-menu class="luxury-user-menu" data-testid="store-header-user-menu" show-header></salla-user-menu>
                </div>

                <a href="{{ link('wishlist') }}" class="luxury-overlay-header__action luxury-overlay-header__icon" aria-label="المفضلة">
                    <i class="sicon-heart"></i>
                </a>

                <div class="luxury-overlay-header__action luxury-overlay-header__cart">
                    <salla-cart-summary data-testid="store-header-cart" class="luxury-overlay-cart">
                        <i slot="icon" class="sicon-shopping-bag"></i>
                    </salla-cart-summary>
                </div>
            </div>
        </div>

        {# Desktop Navigation Menu #}
        <nav class="luxury-overlay-navigation" aria-label="التصنيفات الرئيسية" data-luxury-main-navigation>
            <div class="luxury-overlay-navigation__inner">
                <custom-main-menu></custom-main-menu>
            </div>
        </nav>

        {# Mobile Menu Container Placeholder (Populated dynamically via JS) #}
        <div id="luxury-mobile-menu" class="luxury-overlay-header__mobile-menu" aria-hidden="true">
            <div class="luxury-overlay-header__mobile-menu-inner">
                <div class="luxury-overlay-header__mobile-menu-placeholder"></div>
            </div>
        </div>
    </header>

    {# Hero Main Content Area #}
    <div
        class="luxury-overlay-hero__content 
        {% if component.luxury_content_align == 'left' %}is-left{% elseif component.luxury_content_align == 'right' %}is-right{% else %}is-center{% endif %} 
        {% if component.luxury_enable_animation %}is-animated{% endif %}"
    >
        {# Main Heading #}
        {% if component.luxury_title %}
            <h1 class="luxury-overlay-hero__title">
                {{ component.luxury_title }}
                {% if component.luxury_highlight %}
                    <span class="luxury-overlay-hero__highlight">{{ component.luxury_highlight }}</span>
                {% endif %}
            </h1>
        {% endif %}

        {# Subtitle / Description #}
        {% if component.luxury_description %}
            <p class="luxury-overlay-hero__description">
                {{ component.luxury_description }}
            </p>
        {% endif %}

        {# Social Proof / Rating #}
        {% if component.luxury_show_rating %}
            <div class="luxury-overlay-hero__rating">
                <span>★★★★★</span>
                <small>{{ component.luxury_rating_text ?: 'أكثر من 5000 عميل يثق بنا' }}</small>
            </div>
        {% endif %}

        {# Call To Action Buttons #}
        {% if component.luxury_button_text or component.luxury_show_second_button %}
            <div class="luxury-overlay-hero__buttons">
                {% if component.luxury_button_text %}
                    <a href="{{ component.luxury_button_url ?: store.url }}" class="luxury-overlay-hero__button luxury-overlay-hero__button--primary">
                        {{ component.luxury_button_text }}
                    </a>
                {% endif %}

                {% if component.luxury_show_second_button %}
                    <a href="{{ component.luxury_second_button_url ?: store.url }}" class="luxury-overlay-hero__button luxury-overlay-hero__button--secondary">
                        {{ component.luxury_second_button_text ?: 'اكتشف المزيد' }}
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {# Scroll Down Indicator #}
    {% if component.luxury_show_scroll %}
        <div class="luxury-overlay-hero__scroll" aria-hidden="true">
            <span></span>
        </div>
    {% endif %}
</section>

<style>
.hero-slides-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
}
.hero-slide-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease-in-out, transform 6s ease-out;
    transform: scale(1);
}
.hero-slide-item.active {
    opacity: 1;
    transform: scale(1.05);
    z-index: 1;
}
</style>

<script>
(function () {
    'use strict';

    function initLuxuryHero() {
        var hero = document.querySelector('.cinematic-hero-slideshow');
        if (!hero) return;
        
        // Slideshow Handler
        var slides = hero.querySelectorAll('.hero-slide-item');
        if (slides.length > 1) {
            var speed = parseInt(hero.getAttribute('data-speed')) || 4000;
            var currentIndex = 0;

            setInterval(function () {
                slides[currentIndex].classList.remove('active');
                currentIndex = (currentIndex + 1) % slides.length;
                slides[currentIndex].classList.add('active');
            }, speed);
        }

        // Navigation Menu Handler
        var toggle = hero.querySelector('#luxury-menu-toggle');
        var mobileMenu = hero.querySelector('#luxury-mobile-menu');
        var navigation = hero.querySelector('[data-luxury-main-navigation]');

        if (!toggle || !mobileMenu || !navigation) return;

        var navigationInner = navigation.querySelector('.luxury-overlay-navigation__inner');
        var placeholder = mobileMenu.querySelector('.luxury-overlay-header__mobile-menu-placeholder');

        if (!navigationInner || !placeholder) return;

        var mainMenu = navigationInner.querySelector('custom-main-menu');
        if (!mainMenu) return;

        var mobileBreakpoint = 768;

        function isMobile() {
            return window.innerWidth <= mobileBreakpoint;
        }

        function setMenuClosedState() {
            mobileMenu.classList.remove('is-open');
            mobileMenu.setAttribute('aria-hidden', 'true');
            toggle.setAttribute('aria-expanded', 'false');
        }

        function moveMenu() {
            if (isMobile()) {
                if (mainMenu.parentElement !== placeholder) {
                    placeholder.appendChild(mainMenu);
                }
            } else {
                if (mainMenu.parentElement !== navigationInner) {
                    navigationInner.appendChild(mainMenu);
                }
                setMenuClosedState();
            }
        }

        function toggleMenu() {
            if (!isMobile()) return;

            var isOpen = mobileMenu.classList.contains('is-open');
            if (isOpen) {
                setMenuClosedState();
            } else {
                mobileMenu.classList.add('is-open');
                mobileMenu.setAttribute('aria-hidden', 'false');
                toggle.setAttribute('aria-expanded', 'true');
            }
        }

        toggle.addEventListener('click', toggleMenu);

        var resizeTimer;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(moveMenu, 100);
        });

        document.addEventListener('click', function (event) {
            if (!isMobile() || !mobileMenu.classList.contains('is-open')) return;
            if (mobileMenu.contains(event.target) || toggle.contains(event.target)) return;
            setMenuClosedState();
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') setMenuClosedState();
        });

        moveMenu();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLuxuryHero);
    } else {
        initLuxuryHero();
    }
})();
</script>
{% endif %}