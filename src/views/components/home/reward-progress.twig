{# =========================================================
   LUXURY REWARD PROGRESS
   قسم التقدم نحو المكافأة
========================================================= #}

{% if component.show_section != false %}
    <section
        class="
            luxury-reward-section
            {% if component.show_animation %} luxury-reward-animated{% endif %}
        "
        data-reward-target="{{ component.reward_amount ?: 110 }}"
        data-reward-section
        style="
            background: {{ component.background_color ?: '#FFF5FA' }};
            --reward-accent: {{ component.accent_color ?: '#E62973' }};
        "
    >
        {# Background Glow #}
        <div class="luxury-reward-glow one" aria-hidden="true"></div>
        <div class="luxury-reward-glow two" aria-hidden="true"></div>

        <div class="container">

            {# Header #}
            <div class="luxury-reward-header">
                <div class="luxury-reward-decoration">
                    <span></span>
                    <i></i>
                    <span></span>
                </div>

                <h3>
                    {{ component.title ?: 'أنتِ على بُعد خطوات من مكافأتكِ' }}
                </h3>

                <p>
                    {{ component.subtitle ?: 'أضيفي المزيد لتحصلي على شحن مجاني وهدية فاخرة' }}
                </p>
            </div>

            {# Progress #}
            <div class="luxury-reward-progress">
                <div class="luxury-reward-bar">
                    <div
                        class="luxury-reward-bar-fill"
                        data-progress-bar
                        style="width: 0%;"
                    ></div>
                </div>

                {# Reward Steps #}
                <div class="luxury-reward-steps" dir="ltr">
                    <div class="luxury-reward-step active" data-step="cart">
                        <div class="step-icon">
                            ✓
                        </div>
                        <span>
                            السلة
                        </span>
                    </div>

                    <div class="luxury-reward-step" data-step="shipping">
                        <div class="step-icon">
                            +
                        </div>
                        <span>
                            شحن مجاني
                        </span>
                    </div>

                    <div class="luxury-reward-step" data-step="gift">
                        <div class="step-icon">
                            ♡
                        </div>
                        <span>
                            هدية فاخرة
                        </span>
                    </div>
                </div>
            </div>

            {# Status #}
            <div class="luxury-reward-status">
                <div class="luxury-reward-status-content">
                    <div class="status-icon">
                        ✓
                    </div>

                    <div>
                        <span>
                            المكافأة الحالية:
                        </span>

                        <strong data-reward-status>
                            أضيفي المزيد للحصول على المكافأة
                        </strong>
                    </div>
                </div>

                {# Shopping Button #}
                <a
                    href="{{ link('/') }}"
                    class="luxury-reward-button"
                >
                    {{ component.button_text ?: 'تسوقي المزيد لفتح الهدية' }}

                    <b>
                        ➔
                    </b>
                </a>
            </div>

        </div>
    </section>
{% endif %}