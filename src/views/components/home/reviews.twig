{% if component.show_section != false %}

<section
    id="luxury-testimonials"
    class="
        luxury-testimonials
        {% if component.enable_animation %}
            luxury-testimonials--animated
        {% endif %}
    "
    style="
        --testimonials-bg: {{ component.background_color ?: '#FFF8FB' }};
        --testimonials-card: #FFFFFF;
        --testimonials-accent: {{ component.accent_color ?: '#E62973' }};
        --testimonials-title: #231F20;
        --testimonials-text: #6B7280;
        --testimonials-border: rgba(230, 41, 115, .13);
        --testimonials-radius: 24px;
    "
>

    <!-- Background -->
    <div class="luxury-testimonials__background" aria-hidden="true">
        <span class="luxury-testimonials__orb luxury-testimonials__orb--one"></span>
        <span class="luxury-testimonials__orb luxury-testimonials__orb--two"></span>
        <span class="luxury-testimonials__orb luxury-testimonials__orb--three"></span>
        <span class="luxury-testimonials__grid-pattern"></span>
    </div>


    <div class="container luxury-testimonials__container">

        <!-- Header -->
        <header class="luxury-testimonials__header">

            <div class="luxury-testimonials__eyebrow">

                <span class="luxury-testimonials__eyebrow-line"></span>

                <span class="luxury-testimonials__eyebrow-icon">
                    <i class="sicon-heart"></i>
                </span>

                <span class="luxury-testimonials__eyebrow-line luxury-testimonials__eyebrow-line--reverse"></span>

            </div>


            {% if component.title %}
                <h2 class="luxury-testimonials__title">
                    {{ component.title }}
                    <span class="luxury-testimonials__title-shine"></span>
                </h2>
            {% else %}
                <h2 class="luxury-testimonials__title">
                    تجارب عملائنا
                    <span class="luxury-testimonials__title-shine"></span>
                </h2>
            {% endif %}


            {% if component.subtitle %}
                <p class="luxury-testimonials__subtitle">
                    {{ component.subtitle }}
                </p>
            {% else %}
                <p class="luxury-testimonials__subtitle">
                    آراء حقيقية من عملاء اختاروا الجودة والفخامة
                </p>
            {% endif %}

        </header>


        <!-- Summary -->
        {% if component.show_summary %}

            <div class="luxury-testimonials__summary">

                <div class="luxury-testimonials__summary-glow"></div>

                <div class="luxury-testimonials__summary-rating">

                    <strong>
                        {{ component.average_rating ?: '4.9' }}
                    </strong>

                    <div class="luxury-testimonials__summary-stars">
                        ★★★★★
                    </div>

                </div>


                <div class="luxury-testimonials__summary-divider"></div>


                <div class="luxury-testimonials__summary-info">

                    <span>
                        {{ component.total_reviews ?: '350+' }}
                    </span>

                    <small>
                        {{ component.rating_text ?: 'تقييمات موثوقة من عملائنا' }}
                    </small>

                </div>

            </div>

        {% endif %}


        <!-- Testimonials -->
        {% if component.reviews|length > 0 %}

            <div class="luxury-testimonials__slider-wrapper">

                <div class="luxury-testimonials__side-glow"></div>


                <salla-slider
                    id="luxury-testimonials-slider"
                    type="carousel"
                    loop="true"
                    show-controls="false"
                    auto-play="true"
                >

                    <div
                        slot="items"
                        class="luxury-testimonials__slides"
                    >

                        {% for review in component.reviews %}

                            {% set review_stars = review.stars ?: 5 %}

                            <article
                                class="
                                    luxury-testimonial-card
                                    {% if component.enable_animation %}
                                        luxury-testimonial-card--reveal
                                    {% endif %}
                                "
                            >

                                <!-- Card shine -->
                                <span
                                    class="luxury-testimonial-card__shine"
                                    aria-hidden="true"
                                ></span>


                                <!-- Quote mark -->
                                <span
                                    class="luxury-testimonial-card__quote-decoration"
                                    aria-hidden="true"
                                >
                                    “
                                </span>


                                <!-- Avatar -->
                                <div class="luxury-testimonial-card__avatar-wrapper">

                                    <span class="luxury-testimonial-card__avatar-ring"></span>

                                    {% if review.image %}

                                        <img
                                            src="{{ review.image }}"
                                            alt="{{ review.name ?: 'عميل' }}"
                                            class="luxury-testimonial-card__avatar"
                                            loading="lazy"
                                            decoding="async"
                                        >

                                    {% else %}

                                        <div
                                            class="
                                                luxury-testimonial-card__avatar
                                                luxury-testimonial-card__avatar--fallback
                                            "
                                            aria-hidden="true"
                                        >
                                            <i class="sicon-user"></i>
                                        </div>

                                    {% endif %}

                                    <span class="luxury-testimonial-card__verified">
                                        <i class="sicon-check"></i>
                                    </span>

                                </div>


                                <!-- Customer -->
                                <div class="luxury-testimonial-card__customer">

                                    <h3 class="luxury-testimonial-card__name">
                                        {{ review.name ?: 'عميل مميز' }}
                                    </h3>

                                    {% if review.role %}
                                        <span class="luxury-testimonial-card__role">
                                            {{ review.role }}
                                        </span>
                                    {% endif %}

                                </div>


                                <!-- Stars -->
                                <div
                                    class="luxury-testimonial-card__stars"
                                    aria-label="التقييم {{ review_stars }} من 5"
                                >

                                    {% for i in 1..5 %}

                                        <span
                                            class="{% if i <= review_stars %}is-active{% endif %}"
                                        >
                                            ★
                                        </span>

                                    {% endfor %}

                                </div>


                                <!-- Quote -->
                                <div class="luxury-testimonial-card__quote">

                                    <span class="luxury-testimonial-card__quote-icon">
                                        “
                                    </span>

                                    <p>
                                        {{ review.text ?: 'تجربة رائعة وخدمة مميزة، بالتأكيد سأكرر التجربة مرة أخرى.' }}
                                    </p>

                                </div>


                                <!-- Bottom decoration -->
                                <div
                                    class="luxury-testimonial-card__bottom"
                                    aria-hidden="true"
                                >
                                    <span></span>
                                </div>

                            </article>

                        {% endfor %}

                    </div>

                </salla-slider>

            </div>

        {% else %}

            <div class="luxury-testimonials__empty">

                <i class="sicon-message-text"></i>

                <span>
                    آراء عملائنا ستظهر هنا
                </span>

            </div>

        {% endif %}

    </div>

</section>

{% endif %}
