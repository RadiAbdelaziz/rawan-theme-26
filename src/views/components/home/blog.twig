{% if component.show_section %}
<section class="relative overflow-hidden py-20 lg:py-24" style="background: {{ component.background_color ?: '#FFF8FB' }};">
    <!-- Background effects -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at top right, {{ component.accent_color ?: '#E62973' }}1F, transparent 40%);"></div>
    <div class="absolute -top-32 -right-32 w-[420px] h-[420px] rounded-full blur-3xl pointer-events-none" style="background: {{ component.accent_color ?: '#E62973' }}1A;"></div>
    <div class="absolute bottom-0 left-0 w-[350px] h-[350px] rounded-full blur-3xl pointer-events-none" style="background: #f9a8d4;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full blur-3xl pointer-events-none" style="background: {{ component.accent_color ?: '#E62973' }}1A;"></div>

    <div class="container relative z-10">
        <!-- Header -->
        <div class="flex flex-col lg:flex-row justify-between items-end gap-8 mb-14 text-right">
            <div>
                {% if component.badge %}
                    <span
                        class="inline-flex flex-row-reverse items-center gap-2 px-5 py-2 rounded-full bg-white/70 backdrop-blur-xl border border-pink-200 text-xs font-bold tracking-[.3em]"
                        style="color: {{ component.badge_color ?: component.accent_color ?: '#E62973' }};"
                    >
                        <i class="fa-solid fa-feather-pointed"></i>
                        {{ component.badge }}
                    </span>
                {% endif %}

                {% if component.title %}
                    <h2 class="text-4xl lg:text-5xl font-black mt-6 leading-tight" style="color: {{ component.title_color ?: '#4A0F27' }};">
                        {{ component.title }}
                        {% if component.subtitle %}
                            <span class="block mt-2 text-2xl font-medium" style="color: {{ component.subtitle_color ?: '#777777' }};">
                                {{ component.subtitle }}
                            </span>
                        {% endif %}
                    </h2>
                {% endif %}
            </div>

            <!-- All articles -->
            {% if component.show_all_button %}
                <a
                    href="/blog"
                    class="group flex flex-row-reverse items-center gap-3 font-bold transition duration-300 hover:-translate-x-1"
                    style="color: {{ component.accent_color ?: '#E62973' }};"
                >
                    {{ component.all_button_text ?: 'عرض جميع المقالات' }}
                    <i class="fa-solid fa-arrow-left text-sm transition group-hover:-translate-x-1"></i>
                </a>
            {% endif %}
        </div>

        <!-- Articles -->
        {% if component.articles|length %}
            <div
                class="grid md:grid-cols-2 lg:grid-cols-3 gap-8"
                {% if component.show_animation %}data-blog-animation="true"{% endif %}
            >
                {% for article in component.articles|slice(0, component.articles_count ?: 3) %}
                    <article class="group overflow-hidden rounded-[32px] bg-white/70 backdrop-blur-2xl border border-pink-200 hover:border-[#E62973] hover:shadow-2xl hover:shadow-pink-300/30 transition-all duration-500 hover:-translate-y-3 hover:scale-[1.02]">
                        <!-- Article image -->
                        <a href="{{ article.url }}" class="relative block overflow-hidden">
                            {% if article.has_image and article.image %}
                                <img
                                    src="{{ article.image.url }}"
                                    alt="{{ article.image.alt ?: article.title }}"
                                    loading="lazy"
                                    class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-110 group-hover:rotate-1"
                                >
                            {% else %}
                                <img
                                    src="{{ 'images/placeholder.png'|asset }}"
                                    alt="{{ article.title }}"
                                    loading="lazy"
                                    class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-110 group-hover:rotate-1"
                                >
                            {% endif %}

                            <!-- Image overlay -->
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent pointer-events-none"></div>

                            <!-- Category -->
                            {% if component.show_category and article.tags|length %}
                                <span
                                    class="absolute top-5 right-5 px-4 py-2 rounded-full text-white text-xs font-black transition duration-300 group-hover:bg-pink-700"
                                    style="background: {{ component.accent_color ?: '#E62973' }};"
                                >
                                    {{ article.tags[0].name }}
                                </span>
                            {% endif %}
                        </a>

                        <!-- Article content -->
                        <div class="p-7">
                            <!-- Meta -->
                            <div
                                class="flex flex-row-reverse justify-end items-center gap-6 text-xs mb-5"
                                style="color: {{ component.accent_color ?: '#E62973' }};"
                            >
                                {% if component.show_date %}
                                    <span class="flex flex-row-reverse items-center gap-2">
                                        <i class="fa-regular fa-calendar"></i>
                                        {{ article.created_at|date }}
                                    </span>
                                {% endif %}

                                {% if component.show_views and article.views is defined %}
                                    <span class="flex flex-row-reverse items-center gap-2">
                                        <i class="fa-regular fa-eye"></i>
                                        {{ article.views }}
                                    </span>
                                {% endif %}
                            </div>

                            <!-- Title -->
                            {% if article.title %}
                                <h3 class="text-2xl font-black mb-4 transition duration-300">
                                    <a
                                        href="{{ article.url }}"
                                        class="transition duration-300 group-hover:text-[#E62973]"
                                        style="color: #111111;"
                                    >
                                        {{ article.title }}
                                    </a>
                                </h3>
                            {% endif %}

                            <!-- Summary -->
                            {% if article.summary %}
                                <p class="text-gray-600 leading-8">
                                    {{ article.summary }}
                                </p>
                            {% endif %}

                            <!-- Footer -->
                            <div class="mt-8 pt-6 border-t border-pink-100 flex flex-row-reverse justify-between items-center">
                                <!-- Author -->
                                {% if component.show_author and article.author and article.author.name %}
                                    <span class="text-sm" style="color: {{ component.accent_color ?: '#E62973' }};">
                                        {{ article.author.name }}
                                    </span>
                                {% else %}
                                    <span class="text-sm" style="color: {{ component.accent_color ?: '#E62973' }};">
                                        فريق التحرير
                                    </span>
                                {% endif %}

                                <!-- Read more -->
                                {% if component.show_read_more %}
                                    <a
                                        href="{{ article.url }}"
                                        class="group/link flex flex-row-reverse items-center gap-2 font-bold transition duration-300 hover:text-pink-700"
                                        style="color: {{ component.accent_color ?: '#E62973' }};"
                                    >
                                        <i class="fa-solid fa-arrow-left text-xs transition group-hover/link:-translate-x-1"></i>
                                        {{ component.read_more_text ?: 'قراءة المقال' }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <!-- No articles -->
            <div class="text-center py-16">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-pink-100 text-[#E62973] mb-5">
                    <i class="fa-solid fa-book-open text-xl"></i>
                </div>
                <p class="text-gray-500">
                    لا توجد مقالات لعرضها حالياً.
                </p>
            </div>
        {% endif %}
    </div>
</section>
{% endif %}

