{# =========================================================
   LUXURY CATEGORIES CARDS
   Categories Showcase
   RTL / Safe Category URLs
========================================================= #}

{% if component.show_section != false %}

<section
    class="categories-section reveal-section"
    dir="rtl"
    style="--categories-padding: {{ component.padding ?: 70 }}px;"
>
    <div class="container">

        {# SECTION HEADER #}
        <header class="categories-header">
            <div class="decor-line">
                <span></span>
                <i></i>
                <span></span>
            </div>

            <h2>{{ component.title ?: 'تسوق حسب المجموعة' }}</h2>

            {% if component.show_description != false %}
                <p>{{ component.description ?: 'اكتشفي تشكيلات أنيقة من الأزياء والعطور والإكسسوارات المصممة بذوق راقٍ' }}</p>
            {% endif %}
        </header>

        {# CATEGORIES GRID #}
        {% set categories = component.categories ?: [] %}

        <div class="categories-grid columns-{{ component.columns ?: '4' }}">

            {% for category in categories %}

                {# CATEGORY URL #}
                {% set category_url = category.url ?: (category.slug ? link('categories/' ~ category.slug) : '#') %}

                {# CATEGORY IMAGE #}
                {% set raw_image = category.image.url ?: category.image %}
                {% set category_image = raw_image ? image(raw_image, { w: 600, h: 800, q: 80 }) : 'images/placeholder.png'|asset %}

                {# CATEGORY NAME #}
                {% set category_name = category.name ?: 'مجموعة مميزة' %}

                {# CATEGORY CARD #}
                <a
                    href="{{ category_url }}"
                    class="category-card reveal-card"
                    style="--category-index: {{ loop.index0 }};"
                    aria-label="{{ category_name }}"
                >
                    <img
                        src="{{ category_image }}"
                        alt="{{ category_name }}"
                        loading="lazy"
                        decoding="async"
                    >

                    <div class="overlay" aria-hidden="true"></div>

                    {% if component.show_badge != false and category.badge %}
                        <span class="category-badge">{{ category.badge }}</span>
                    {% endif %}

                    <div class="content">
                        <h3>{{ category_name }}</h3>

                        {% if component.show_description != false and category.description %}
                            <p>{{ category.description }}</p>
                        {% endif %}

                        {% if category.products_count is defined and category.products_count is not null %}
                            <span class="category-count">
                                {{ category.products_count }} <span>منتج</span>
                            </span>
                        {% endif %}

                        {% if component.show_arrow != false %}
                            <span class="category-arrow" aria-hidden="true">
                                <i class="sicon-arrow-left"></i>
                            </span>
                        {% endif %}
                    </div>
                </a>

            {% else %}

                {# EMPTY STATE #}
                <div class="categories-empty">
                    لم يتم اختيار أي مجموعات
                </div>

            {% endfor %}

        </div>
    </div>
</section>

{% endif %}