{# =========================================================
   CATEGORIES CARDS
   بطاقات المجموعات
   RTL / Overflow Safe
========================================================= #}


{# =========================================================
   SECTION VISIBILITY
   إظهار أو إخفاء القسم
========================================================= #}

{% if component.show_section != false %}


    {# =====================================================
       DEFAULT DATA
       البيانات الافتراضية
    ===================================================== #}

    {% set default_images = [
        'women.jpg',
        'men.jpg',
        'kids.jpg',
        'offers.jpg'
    ] %}


    {% set default_titles = [
        'نسائي',
        'رجالي',
        'أطفال',
        'عروض'
    ] %}


    {% set default_subtitles = [
        'اكتشفي أحدث التشكيلات',
        'أناقة عصرية مميزة',
        'راحة وأناقة للصغار',
        'اقتني الفرصة الآن'
    ] %}


    {# =====================================================
       COMPONENT ITEMS
       العناصر القادمة من لوحة التحكم
    ===================================================== #}

    {% set categories = component.items ?: [] %}


    {# =====================================================
       FALLBACK ITEMS
       بيانات افتراضية في حال عدم اختيار عناصر
    ===================================================== #}

    {% if categories|length == 0 %}

        {% set categories = [

            {
                "title": "نسائي",
                "subtitle": "اكتشفي أحدث التشكيلات"
            },

            {
                "title": "رجالي",
                "subtitle": "أناقة عصرية مميزة"
            },

            {
                "title": "أطفال",
                "subtitle": "راحة وأناقة للصغار"
            },

            {
                "title": "عروض",
                "subtitle": "اقتني الفرصة الآن",
                "badge": "خصم 50%"
            }

        ] %}

    {% endif %}


    {# =====================================================
       SECTION
       القسم الرئيسي
    ===================================================== #}

    <section
        class="
            categories-section
            {% if component.enable_animation == false %}
                categories-section--no-animation
            {% endif %}
        "
        dir="rtl"
        style="
            --categories-columns: {{ component.columns ?: '4' }};
            --categories-padding: {{ component.padding ?: '70' }}px;
        "
    >

        <div class="container">


            {# =================================================
               SECTION HEADER
               عنوان القسم
            ================================================= #}

            <header class="categories-header">


                {# =================================================
                   DECORATIVE LINE
                   الخط الزخرفي
                ================================================= #}

                <div class="decor-line">

                    <span></span>

                    <i></i>

                    <span></span>

                </div>


                {# =================================================
                   MAIN TITLE
                   العنوان الرئيسي
                ================================================= #}

                <h2>
                    {{ component.title ?: 'تسوق حسب المجموعة' }}
                </h2>


                {# =================================================
                   SECTION DESCRIPTION
                   وصف القسم
                ================================================= #}

                {% if component.show_description != false %}

                    <p>
                        {{ component.description ?: 'اكتشفي تشكيلات أنيقة من الأزياء والعطور والإكسسوارات المصممة بذوق راقٍ' }}
                    </p>

                {% endif %}


            </header>


            {# =================================================
               CATEGORIES GRID
               شبكة بطاقات المجموعات
            ================================================= #}

            <div
                class="
                    categories-grid
                    categories-grid--columns-{{ component.columns ?: '4' }}
                "
            >


                {# =================================================
                   CATEGORY LOOP
                   عرض البطاقات
                ================================================= #}

                {% for item in categories|slice(0, 4) %}


                    {# =================================================
                       ITEM URL
                       رابط البطاقة
                       
                       الأولوية:
                       1. category.url
                       2. category.slug
                       3. category.link
                       4. الرابط الخارجي
                    ================================================= #}

                    {% set item_url = '#' %}


                    {# =================================================
                       CATEGORY URL
                       رابط الفئة المختارة
                    ================================================= #}

                    {% if item.category %}

                        {% if item.category.url is defined and item.category.url %}

                            {% set item_url = item.category.url %}

                        {% elseif item.category.slug is defined and item.category.slug %}

                            {% set item_url = link(
                                'categories/' ~ item.category.slug
                            ) %}

                        {% elseif item.category.link is defined and item.category.link %}

                            {% set item_url = item.category.link %}

                        {% endif %}

                    {% endif %}


                    {# =================================================
                       CUSTOM URL
                       الرابط الخارجي له الأولوية
                    ================================================= #}

                    {% if item.link %}

                        {% set item_url = item.link %}

                    {% endif %}


                    {# =================================================
                       ITEM IMAGE
                       صورة البطاقة
                    ================================================= #}

                    {% set item_image = (
                        'images/categories/' ~ default_images[loop.index0]
                    )|asset %}


                    {% if item.image %}

                        {% if item.image.url is defined and item.image.url %}

                            {% set item_image = item.image.url %}

                        {% else %}

                            {% set item_image = item.image %}

                        {% endif %}

                    {% endif %}


                    {# =================================================
                       ITEM TITLE
                       عنوان البطاقة
                    ================================================= #}

                    {% set item_title =
                        item.title
                        ?: default_titles[loop.index0]
                    %}


                    {# =================================================
                       ITEM SUBTITLE
                       الوصف المختصر
                    ================================================= #}

                    {% set item_subtitle =
                        item.subtitle
                        ?: default_subtitles[loop.index0]
                    %}


                    {# =================================================
                       CATEGORY CARD
                       البطاقة
                    ================================================= #}

                    <a
                        href="{{ item_url }}"
                        class="category-card"
                        style="--category-index: {{ loop.index0 }};"
                        aria-label="{{ item_title }}"
                    >


                        {# =================================================
                           IMAGE
                           الصورة
                        ================================================= #}

                        <img
                            src="{{ item_image }}"
                            alt="{{ item_title }}"
                            loading="lazy"
                            decoding="async"
                        >


                        {# =================================================
                           IMAGE OVERLAY
                           طبقة التدرج
                        ================================================= #}

                        <div
                            class="overlay"
                            aria-hidden="true"
                        ></div>


                        {# =================================================
                           BADGE
                           الشارة
                        ================================================= #}

                        {% if component.show_badge != false and item.badge %}

                            <span class="category-badge">

                                {{ item.badge }}

                            </span>

                        {% endif %}


                        {# =================================================
                           CARD CONTENT
                           محتوى البطاقة
                        ================================================= #}

                        <div class="content">


                            {# =================================================
                               TITLE
                               عنوان البطاقة
                            ================================================= #}

                            <h3>
                                {{ item_title }}
                            </h3>


                            {# =================================================
                               SUBTITLE
                               العنوان الفرعي
                            ================================================= #}

                            {% if component.show_description != false and item_subtitle %}

                                <p>
                                    {{ item_subtitle }}
                                </p>

                            {% endif %}


                            {# =================================================
                               ARROW
                               سهم الانتقال
                            ================================================= #}

                            {% if component.show_arrow != false %}

                                <span
                                    class="category-arrow"
                                    aria-hidden="true"
                                >

                                    <i class="sicon-arrow-left"></i>

                                </span>

                            {% endif %}


                        </div>


                    </a>


                {% endfor %}


            </div>


        </div>

    </section>


{% endif %}