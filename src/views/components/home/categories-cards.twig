{# =========================================================
   DEFAULT DATA
   البيانات الافتراضية للقسم
========================================================= #}

{% set default_images = [
    'women.jpg',
    'men.jpg',
    'kids.jpg',
    'offers.jpg'
] %}

{% set default_titles = [
    'نسائي',
    'رجالي',
    'أطفال',
    'عروض'
] %}

{% set default_subtitles = [
    'اكتشفي أحدث التشكيلات',
    'أناقة عصرية مميزة',
    'راحة وأناقة للصغار',
    'اقتني الفرصة الآن'
] %}

{% set default_links = [
    link('/categories'),
    link('/categories'),
    link('/categories'),
    link('/categories')
] %}


{# =========================================================
   SECTION VISIBILITY
   إظهار أو إخفاء القسم
========================================================= #}

{% if component.show_section != false %}


    {# =====================================================
       COMPONENT ITEMS
       العناصر القادمة من لوحة التحكم
    ===================================================== #}

    {% set categories = component.items ?: [] %}


    {# =====================================================
       FALLBACK ITEMS
       بيانات افتراضية في حال عدم إضافة عناصر
    ===================================================== #}

    {% if categories|length == 0 %}

        {% set categories = [
            {
                "title": "نسائي",
                "subtitle": "اكتشفي أحدث التشكيلات"
            },
            {
                "title": "رجالي",
                "subtitle": "أناقة عصرية مميزة"
            },
            {
                "title": "أطفال",
                "subtitle": "راحة وأناقة للصغار"
            },
            {
                "title": "عروض",
                "subtitle": "اقتني الفرصة الآن",
                "badge": "خصم 50%"
            }
        ] %}

    {% endif %}


    {# =====================================================
       SECTION
       القسم الرئيسي
    ===================================================== #}

    <section
        class="categories-section{% if component.enable_animation == false %} categories-section--no-animation{% endif %}"
        style="
            --categories-columns: {{ component.columns ?: '4' }};
            --categories-padding: {{ component.padding ?: '70' }}px;
        "
    >

        <div class="container">


            {# =================================================
               HEADER
               عنوان ووصف القسم
            ================================================= #}

            <header class="categories-header">


                {# Decorative Line #}

                <div class="decor-line">

                    <span></span>

                    <i></i>

                    <span></span>

                </div>


                {# Main Title #}

                {% if component.title %}

                    <h2>
                        {{ component.title }}
                    </h2>

                {% else %}

                    <h2>
                        تسوق حسب المجموعة
                    </h2>

                {% endif %}


                {# Description #}

                {% if component.show_description != false %}

                    {% if component.description %}

                        <p>
                            {{ component.description }}
                        </p>

                    {% else %}

                        <p>
                            اكتشفي تشكيلات أنيقة من الأزياء والعطور والإكسسوارات المصممة بذوق راقٍ
                        </p>

                    {% endif %}

                {% endif %}


            </header>


            {# =================================================
               CATEGORIES GRID
               شبكة بطاقات المجموعات
            ================================================= #}

            <div
                class="categories-grid categories-grid--columns-{{ component.columns ?: '4' }}"
            >


                {# =================================================
                   LOOP
                   عرض بحد أقصى 4 بطاقات
                ================================================= #}

                {% for item in categories|slice(0, 4) %}


                    {# =================================================
                       ITEM URL
                       تحديد الرابط النهائي للبطاقة
                    ================================================= #}

                    {% set item_url = default_links[loop.index0] %}


                    {# -------------------------------------------------
                       CATEGORY LINK
                    ------------------------------------------------- #}

                    {% if item.category %}

                        {% if item.category.url is defined and item.category.url %}

                            {% set item_url = item.category.url %}

                        {% elseif item.category.link is defined and item.category.link %}

                            {% set item_url = item.category.link %}

                        {% endif %}

                    {% endif %}


                    {# -------------------------------------------------
                       CUSTOM LINK
                       الرابط الخارجي له الأولوية
                    ------------------------------------------------- #}

                    {% if item.link %}

                        {% set item_url = item.link %}

                    {% endif %}


                    {# =================================================
                       ITEM IMAGE
                       تحديد صورة البطاقة
                    ================================================= #}

                    {% set item_image = (
                        'images/categories/' ~ default_images[loop.index0]
                    )|asset %}


                    {% if item.image %}

                        {% if item.image.url is defined and item.image.url %}

                            {% set item_image = item.image.url %}

                        {% else %}

                            {% set item_image = item.image %}

                        {% endif %}

                    {% endif %}


                    {# =================================================
                       ITEM TITLE
                       عنوان البطاقة
                    ================================================= #}

                    {% set item_title = item.title ?: default_titles[loop.index0] %}


                    {# =================================================
                       ITEM SUBTITLE
                       الوصف المختصر
                    ================================================= #}

                    {% set item_subtitle = (
                        item.subtitle ?: default_subtitles[loop.index0]
                    ) %}


                    {# =================================================
                       CATEGORY CARD
                    ================================================= #}

                    <a
                        href="{{ item_url }}"
                        class="category-card"
                        aria-label="{{ item_title }}"
                        style="--category-index: {{ loop.index0 }};"
                    >


                        {# =================================================
                           IMAGE
                        ================================================= #}

                        <img
                            src="{{ item_image }}"
                            alt="{{ item_title }}"
                            loading="lazy"
                        >


                        {# =================================================
                           IMAGE OVERLAY
                        ================================================= #}

                        <div class="overlay"></div>


                        {# =================================================
                           BADGE
                        ================================================= #}

                        {% if component.show_badge != false and item.badge %}

                            <span class="category-badge">
                                {{ item.badge }}
                            </span>

                        {% endif %}


                        {# =================================================
                           CARD CONTENT
                        ================================================= #}

                        <div class="content">


                            {# Card Title #}

                            <h3>
                                {{ item_title }}
                            </h3>


                            {# Card Subtitle #}

                            {% if component.show_description != false and item_subtitle %}

                                <p>
                                    {{ item_subtitle }}
                                </p>

                            {% endif %}


                            {# =================================================
                               ARROW
                            ================================================= #}

                            {% if component.show_arrow != false %}

                                <span
                                    class="category-arrow"
                                    aria-hidden="true"
                                >
                                    <i class="sicon-arrow-left"></i>
                                </span>

                            {% endif %}


                        </div>


                    </a>


                {% endfor %}


            </div>


        </div>

    </section>


{% endif %}