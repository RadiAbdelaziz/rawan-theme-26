{# =========================================================
   DEFAULT DATA
   البيانات الافتراضية للقسم
========================================================= #}

{% set default_images = [
    'women.jpg',
    'men.jpg',
    'kids.jpg',
    'offers.jpg'
] %}

{% set default_titles = [
    'نسائي',
    'رجالي',
    'أطفال',
    'عروض'
] %}

{% set default_subtitles = [
    'اكتشفي أحدث التشكيلات',
    'أناقة عصرية مميزة',
    'راحة وأناقة للصغار',
    'اقتني الفرصة الآن'
] %}


{# =========================================================
   DEFAULT LINKS
   الروابط الافتراضية في حال عدم اختيار فئة أو رابط
========================================================= #}

{% set default_links = [
    link('/categories'),
    link('/categories'),
    link('/categories'),
    link('/categories')
] %}


{# =========================================================
   COMPONENT ITEMS
   العناصر القادمة من لوحة التحكم
========================================================= #}

{% set categories = component.items ?: [] %}


{# =========================================================
   FALLBACK ITEMS
   بيانات بديلة في حال عدم إضافة عناصر من لوحة التحكم
========================================================= #}

{% if categories|length == 0 %}

    {% set categories = [
        {
            "title": "نسائي",
            "subtitle": "اكتشفي أحدث التشكيلات"
        },
        {
            "title": "رجالي",
            "subtitle": "أناقة عصرية مميزة"
        },
        {
            "title": "أطفال",
            "subtitle": "راحة وأناقة للصغار"
        },
        {
            "title": "عروض",
            "subtitle": "اقتني الفرصة الآن",
            "badge": "خصم 50%"
        }
    ] %}

{% endif %}


{# =========================================================
   SECTION
========================================================= #}

<section class="categories-section reveal-section">

    <div class="container">


        {# =====================================================
           SECTION HEADER
           عنوان ووصف القسم
        ===================================================== #}

        <header class="categories-header">


            {# Decorative Line #}

            <div class="decor-line">

                <span></span>

                <i></i>

                <span></span>

            </div>


            {# Title #}

            <h2>
                {{ component.title ?: 'تسوق حسب المجموعة' }}
            </h2>


            {# Description #}

            {% if component.description %}

                <p>
                    {{ component.description }}
                </p>

            {% else %}

                <p>
                    اكتشفي تشكيلات أنيقة من الأزياء والعطور والإكسسوارات المصممة بذوق راقٍ
                </p>

            {% endif %}


        </header>


        {# =====================================================
           CATEGORIES GRID
           شبكة بطاقات المجموعات
        ===================================================== #}

        <div class="categories-grid">


            {# -------------------------------------------------
               LIMIT TO 4 ITEMS
            ------------------------------------------------- #}

            {% for item in categories|slice(0, 4) %}


                {# =================================================
                   ITEM LINK
                   تحديد الرابط النهائي للبطاقة
                ================================================= #}

                {% set item_url = default_links[loop.index0] %}


                {# Category URL #}

                {% if item.category %}

                    {% if item.category.url is defined and item.category.url %}

                        {% set item_url = item.category.url %}

                    {% elseif item.category.link is defined and item.category.link %}

                        {% set item_url = item.category.link %}

                    {% elseif item.category is string %}

                        {% set item_url = item.category %}

                    {% endif %}

                {% endif %}


                {# External / Custom URL
                   له الأولوية في حال وجوده #}

                {% if item.link %}

                    {% set item_url = item.link %}

                {% endif %}


                {# =================================================
                   ITEM IMAGE
                   تحديد صورة البطاقة
                ================================================= #}

                {% set item_image = (
                    'images/categories/' ~ default_images[loop.index0]
                )|asset %}


                {% if item.image %}

                    {% if item.image.url is defined and item.image.url %}

                        {% set item_image = item.image.url %}

                    {% else %}

                        {% set item_image = item.image %}

                    {% endif %}

                {% endif %}


                {# =================================================
                   ITEM TITLE
                   عنوان البطاقة
                ================================================= #}

                {% set item_title = item.title ?: default_titles[loop.index0] %}


                {# =================================================
                   ITEM SUBTITLE
                   الوصف المختصر للبطاقة
                ================================================= #}

                {% set item_subtitle = (
                    item.subtitle ?: default_subtitles[loop.index0]
                ) %}


                {# =================================================
                   CATEGORY CARD
                ================================================= #}

                <a
                    href="{{ item_url }}"
                    class="category-card reveal-section"
                    aria-label="{{ item_title }}"
                    style="--category-index: {{ loop.index0 }};"
                >


                    {# =================================================
                       IMAGE
                    ================================================= #}

                    <img
                        src="{{ item_image }}"
                        alt="{{ item_title }}"
                        loading="lazy"
                    >


                    {# =================================================
                       IMAGE OVERLAY
                    ================================================= #}

                    <div class="overlay"></div>


                    {# =================================================
                       BADGE
                    ================================================= #}

                    {% if item.badge %}

                        <span class="category-badge">
                            {{ item.badge }}
                        </span>

                    {% endif %}


                    {# =================================================
                       CARD CONTENT
                    ================================================= #}

                    <div class="content">


                        {# Card Title #}

                        <h3>
                            {{ item_title }}
                        </h3>


                        {# Card Subtitle #}

                        {% if item_subtitle %}

                            <p>
                                {{ item_subtitle }}
                            </p>

                        {% endif %}


                        {# Optional Arrow #}

                        <span class="category-arrow" aria-hidden="true">
                            <i class="sicon-arrow-left"></i>
                        </span>


                    </div>


                </a>


            {% endfor %}


        </div>


    </div>

</section>