{# =========================================================
   CATEGORIES CARDS
   Luxury Categories Showcase
   RTL / Safe Category Links
========================================================= #}


{# =========================================================
   DEFAULT DATA
========================================================= #}

{% set default_images = [
    'women.jpg',
    'men.jpg',
    'kids.jpg',
    'offers.jpg'
] %}


{% set default_titles = [
    'نسائي',
    'رجالي',
    'أطفال',
    'عروض'
] %}


{% set default_subtitles = [
    'اكتشفي أحدث التشكيلات',
    'أناقة عصرية مميزة',
    'راحة وأناقة للصغار',
    'اقتني الفرصة الآن'
] %}


{# =========================================================
   DEFAULT LINKS
========================================================= #}

{% set default_links = [
    link('/categories'),
    link('/categories'),
    link('/categories'),
    link('/categories')
] %}


{# =========================================================
   COMPONENT ITEMS
========================================================= #}

{% set categories = component.items ?: [] %}


{# =========================================================
   FALLBACK ITEMS
========================================================= #}

{% if categories|length == 0 %}

    {% set categories = [
        {
            "title": "نسائي",
            "subtitle": "اكتشفي أحدث التشكيلات"
        },
        {
            "title": "رجالي",
            "subtitle": "أناقة عصرية مميزة"
        },
        {
            "title": "أطفال",
            "subtitle": "راحة وأناقة للصغار"
        },
        {
            "title": "عروض",
            "subtitle": "اقتني الفرصة الآن",
            "badge": "خصم 50%"
        }
    ] %}

{% endif %}


{# =========================================================
   SECTION
========================================================= #}

<section
    class="categories-section reveal-section"
    dir="rtl"
    style="
        --categories-padding: {{ component.padding ?: 70 }}px;
    "
>

    <div class="container">


        {# =====================================================
           HEADER
        ===================================================== #}

        <header class="categories-header">


            {# Decorative Line #}

            <div class="decor-line">

                <span></span>

                <i></i>

                <span></span>

            </div>


            {# Title #}

            <h2>

                {{ component.title ?: 'تسوق حسب المجموعة' }}

            </h2>


            {# Description #}

            {% if component.show_description != false %}

                <p>

                    {{ component.description ?: 'اكتشفي تشكيلات أنيقة من الأزياء والعطور والإكسسوارات المصممة بذوق راقٍ' }}

                </p>

            {% endif %}


        </header>


        {# =====================================================
           CATEGORIES GRID
        ===================================================== #}

        <div class="categories-grid">


            {# =================================================
               LOOP
            ================================================= #}

            {% for item in categories|slice(0, 4) %}


                {# =================================================
                   TITLE
                ================================================= #}

                {% set item_title =
                    item.title ?: default_titles[loop.index0]
                %}


                {# =================================================
                   SUBTITLE
                ================================================= #}

                {% set item_subtitle =
                    item.subtitle ?: default_subtitles[loop.index0]
                %}


                {# =================================================
                   CATEGORY URL

                   إذا تم اختيار فئة من لوحة التحكم:
                   نستخدم رابط الفئة مباشرة.

                   إذا لم توجد فئة:
                   نستخدم الرابط الخارجي.

                   إذا لم يوجد أي منهما:
                   نستخدم الرابط الافتراضي.
                ================================================= #}

                {% set item_url = default_links[loop.index0] %}


                {% if item.category and item.category.url %}

                    {% set item_url = item.category.url %}

                {% elseif item.link %}

                    {% set item_url = item.link %}

                {% endif %}


                {# =================================================
                   IMAGE
                ================================================= #}

                {% set item_image =
                    ('images/categories/' ~ default_images[loop.index0])|asset
                %}


                {% if item.image %}

                    {% if item.image.url %}

                        {% set item_image = item.image.url %}

                    {% else %}

                        {% set item_image = item.image %}

                    {% endif %}

                {% endif %}


                {# =================================================
                   CATEGORY CARD
                ================================================= #}

                <a
                    href="{{ item_url }}"
                    class="category-card reveal-card"
                    style="--category-index: {{ loop.index0 }};"
                    aria-label="{{ item_title }}"
                >


                    {# =================================================
                       IMAGE
                    ================================================= #}

                    <img
                        src="{{ item_image }}"
                        alt="{{ item_title }}"
                        loading="lazy"
                        decoding="async"
                    >


                    {# =================================================
                       OVERLAY
                    ================================================= #}

                    <div
                        class="overlay"
                        aria-hidden="true"
                    ></div>


                    {# =================================================
                       BADGE
                    ================================================= #}

                    {% if component.show_badge != false and item.badge %}

                        <span class="category-badge">

                            {{ item.badge }}

                        </span>

                    {% endif %}


                    {# =================================================
                       CONTENT
                    ================================================= #}

                    <div class="content">


                        {# Card Title #}

                        <h3>

                            {{ item_title }}

                        </h3>


                        {# Card Subtitle #}

                        {% if item_subtitle %}

                            <p>

                                {{ item_subtitle }}

                            </p>

                        {% endif %}


                        {# =================================================
                           ARROW
                        ================================================= #}

                        {% if component.show_arrow != false %}

                            <span
                                class="category-arrow"
                                aria-hidden="true"
                            >

                                <i class="sicon-arrow-left"></i>

                            </span>

                        {% endif %}


                    </div>


                </a>


            {% endfor %}


        </div>


    </div>

</section>