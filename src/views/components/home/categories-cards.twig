{# =========================================================
   CATEGORIES CARDS
   Luxury Categories Showcase
   RTL / Overflow Safe
========================================================= #}


{# =========================================================
   DEFAULT DATA
   البيانات الافتراضية للقسم
========================================================= #}

{% set default_images = [
    'women.jpg',
    'men.jpg',
    'kids.jpg',
    'offers.jpg'
] %}


{% set default_titles = [
    'نسائي',
    'رجالي',
    'أطفال',
    'عروض'
] %}


{% set default_subtitles = [
    'اكتشفي أحدث التشكيلات',
    'أناقة عصرية مميزة',
    'راحة وأناقة للصغار',
    'اقتني الفرصة الآن'
] %}


{# =========================================================
   DEFAULT LINKS
   روابط احتياطية في حال عدم اختيار فئة
========================================================= #}

{% set default_links = [
    link('/categories'),
    link('/categories'),
    link('/categories'),
    link('/categories')
] %}


{# =========================================================
   COMPONENT ITEMS
   العناصر القادمة من لوحة التحكم
========================================================= #}

{% set categories = component.items ?: [] %}


{# =========================================================
   FALLBACK ITEMS
   بيانات افتراضية في حال عدم إضافة عناصر
========================================================= #}

{% if categories|length == 0 %}

    {% set categories = [

        {
            "title": "نسائي",
            "subtitle": "اكتشفي أحدث التشكيلات"
        },

        {
            "title": "رجالي",
            "subtitle": "أناقة عصرية مميزة"
        },

        {
            "title": "أطفال",
            "subtitle": "راحة وأناقة للصغار"
        },

        {
            "title": "عروض",
            "subtitle": "اقتني الفرصة الآن",
            "badge": "خصم 50%"
        }

    ] %}

{% endif %}


{# =========================================================
   SECTION
========================================================= #}

{% if component.show_section != false %}

<section
    class="categories-section reveal-section"
    dir="rtl"
    style="
        --categories-padding: {{ component.padding ?: 70 }}px;
    "
>

    <div class="container">


        {# =====================================================
           SECTION HEADER
           عنوان ووصف القسم
        ===================================================== #}

        <header class="categories-header">


            {# =================================================
               DECORATIVE LINE
            ================================================= #}

            <div class="decor-line">

                <span></span>

                <i></i>

                <span></span>

            </div>


            {# =================================================
               MAIN TITLE
            ================================================= #}

            <h2>

                {{ component.title ?: 'تسوق حسب المجموعة' }}

            </h2>


            {# =================================================
               DESCRIPTION
            ================================================= #}

            {% if component.show_description != false %}

                <p>

                    {{ component.description ?: 'اكتشفي تشكيلات أنيقة من الأزياء والعطور والإكسسوارات المصممة بذوق راقٍ' }}

                </p>

            {% endif %}


        </header>


        {# =====================================================
           CATEGORIES GRID
        ===================================================== #}

        <div
            class="
                categories-grid
                columns-{{ component.columns ?: '4' }}
            "
        >


            {# =================================================
               CATEGORY ITEMS
            ================================================= #}

            {% for item in categories|slice(0, 4) %}


                {# =================================================
                   ITEM TITLE
                ================================================= #}

                {% set item_title =
                    item.title
                    ?: default_titles[loop.index0]
                %}


                {# =================================================
                   ITEM SUBTITLE
                ================================================= #}

                {% set item_subtitle =
                    item.subtitle
                    ?: default_subtitles[loop.index0]
                %}


                {# =================================================
                   CATEGORY URL

                   الأولوية:
                   1. رابط الفئة المختارة
                   2. slug الخاص بالفئة
                   3. الرابط الخارجي
                   4. الرابط الافتراضي
                ================================================= #}

                {% set item_url = default_links[loop.index0] %}


                {% if item.category %}

                    {# -----------------------------------------
                       Category URL
                    ----------------------------------------- #}

                    {% if item.category.url is defined and item.category.url %}

                        {% set item_url = item.category.url %}


                    {# -----------------------------------------
                       Category Link
                    ----------------------------------------- #}

                    {% elseif item.category.link is defined and item.category.link %}

                        {% set item_url = item.category.link %}


                    {# -----------------------------------------
                       Category Slug
                       إنشاء رابط صفحة الفئة
                    ----------------------------------------- #}

                    {% elseif item.category.slug is defined and item.category.slug %}

                        {% set item_url =
                            link('categories/' ~ item.category.slug)
                        %}


                    {# -----------------------------------------
                       إذا كانت القيمة نفسها عبارة عن رابط
                    ----------------------------------------- #}

                    {% elseif item.category is string %}

                        {% set item_url = item.category %}

                    {% endif %}


                {# =================================================
                   CUSTOM LINK

                   يستخدم فقط إذا لم يتم اختيار فئة
                ================================================= #}

                {% elseif item.link %}

                    {% set item_url = item.link %}

                {% endif %}


                {# =================================================
                   ITEM IMAGE
                ================================================= #}

                {% set item_image = (
                    'images/categories/' ~ default_images[loop.index0]
                )|asset %}


                {% if item.image %}

                    {% if item.image.url is defined and item.image.url %}

                        {% set item_image = item.image.url %}

                    {% else %}

                        {% set item_image = item.image %}

                    {% endif %}

                {% endif %}


                {# =================================================
                   CATEGORY CARD
                ================================================= #}

                <a
                    href="{{ item_url }}"
                    class="category-card reveal-card"
                    style="--category-index: {{ loop.index0 }};"
                    aria-label="{{ item_title }}"
                >


                    {# =================================================
                       IMAGE
                    ================================================= #}

                    <img
                        src="{{ item_image }}"
                        alt="{{ item_title }}"
                        loading="lazy"
                        decoding="async"
                    >


                    {# =================================================
                       IMAGE OVERLAY
                    ================================================= #}

                    <div
                        class="overlay"
                        aria-hidden="true"
                    ></div>


                    {# =================================================
                       BADGE
                    ================================================= #}

                    {% if component.show_badge != false and item.badge %}

                        <span class="category-badge">

                            {{ item.badge }}

                        </span>

                    {% endif %}


                    {# =================================================
                       CARD CONTENT
                    ================================================= #}

                    <div class="content">


                        {# =================================================
                           CARD TITLE
                        ================================================= #}

                        <h3>

                            {{ item_title }}

                        </h3>


                        {# =================================================
                           CARD SUBTITLE
                        ================================================= #}

                        {% if item_subtitle %}

                            <p>

                                {{ item_subtitle }}

                            </p>

                        {% endif %}


                        {# =================================================
                           ARROW
                        ================================================= #}

                        {% if component.show_arrow != false %}

                            <span
                                class="category-arrow"
                                aria-hidden="true"
                            >

                                <i class="sicon-arrow-left"></i>

                            </span>

                        {% endif %}


                    </div>


                </a>


            {% endfor %}


        </div>


    </div>

</section>

{% endif %}