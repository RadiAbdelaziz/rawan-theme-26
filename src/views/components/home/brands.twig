{# =========================================================
   LUXURY BRANDS
   الماركات التجارية - Luxury Brands Showcase
========================================================= #}

{% if component.brands|length %}

<section class="luxury-brands">

    {# =====================================================
       BACKGROUND DECORATION
    ===================================================== #}

    <div
        class="luxury-brands__glow luxury-brands__glow--one"
        aria-hidden="true"
    ></div>

    <div
        class="luxury-brands__glow luxury-brands__glow--two"
        aria-hidden="true"
    ></div>

    <div
        class="luxury-brands__pattern"
        aria-hidden="true"
    ></div>


    <div class="container">

        {# =================================================
           HEADER
        ================================================= #}

        <header class="luxury-brands__header">

            <div class="luxury-brands__eyebrow" aria-hidden="true">

                <span></span>

                <i class="sicon-award-ribbon"></i>

                <span></span>

            </div>


            <h2 class="luxury-brands__title">

                {{ component.title ?: 'تصفح من خلال العلامات التجارية' }}

            </h2>


            <div class="luxury-brands__line" aria-hidden="true"></div>

        </header>


        {# =================================================
           BRANDS SHOWCASE
        ================================================= #}

        <div class="luxury-brands__showcase">

            <div class="luxury-brands__track">

                {% for brand in component.brands %}

                    {# =========================================
                       BRAND ITEM
                    ========================================= #}

                    <a
                        href="{{ brand.url ?: '#' }}"
                        class="luxury-brand"
                        aria-label="{{ brand.name ?: 'ماركة تجارية' }}"
                    >

                        <span class="luxury-brand__inner">

                            {# =================================
                               BRAND IMAGE
                            ================================= #}

                            <span class="luxury-brand__logo">

                                {% if brand.image %}

                                    <img
                                        src="{{ brand.image.url ?: brand.image }}"
                                        alt="{{ brand.name ?: 'ماركة تجارية' }}"
                                        loading="lazy"
                                        decoding="async"
                                    >

                                {% else %}

                                    <span class="luxury-brand__fallback">

                                        <i class="sicon-award-ribbon"></i>

                                    </span>

                                {% endif %}

                            </span>


                            {# =================================
                               BRAND NAME
                            ================================= #}

                            {% if brand.name %}

                                <span class="luxury-brand__name">

                                    {{ brand.name }}

                                </span>

                            {% endif %}


                            {# =================================
                               DECORATIVE ARROW
                            ================================= #}

                            <span
                                class="luxury-brand__arrow"
                                aria-hidden="true"
                            >

                                <i class="sicon-arrow-left"></i>

                            </span>

                        </span>

                    </a>

                {% endfor %}

            </div>

        </div>


        {# =================================================
           BOTTOM DECORATION
        ================================================= #}

        <div
            class="luxury-brands__bottom-line"
            aria-hidden="true"
        >

            <span></span>

            <i class="sicon-heart"></i>

            <span></span>

        </div>

    </div>

</section>

{% endif %}
