{% if component.show_section %}
    <section
        class="luxury-faq"
        style="
            --faq-accent-color: {{ component.accent_color }};
            --faq-title-color: {{ component.title_color }};
            --faq-subtitle-color: {{ component.subtitle_color }};
            --faq-background-color: {{ component.background_color }};
        "
    >
        <div class="luxury-faq__background"></div>

        <div class="container">
            {# Header #}
            <div class="luxury-faq__header">
                {% if component.show_badge and component.badge %}
                    <span class="luxury-faq__badge">
                        <span class="luxury-faq__badge-dot"></span>
                        {{ component.badge }}
                    </span>
                {% endif %}

                {% if component.title %}
                    <h2 class="luxury-faq__title">
                        {{ component.title }}
                        <span class="luxury-faq__underline"></span>
                    </h2>
                {% endif %}

                {% if component.subtitle %}
                    <p class="luxury-faq__subtitle">
                        {{ component.subtitle }}
                    </p>
                {% endif %}
            </div>

            {# Faq #}
            {% if component.questions|length %}
                <div class="luxury-faq__list">
                    {% for item in component.questions %}
                        {% if item.question and item.answer %}
                            <details
                                class="luxury-faq__item"
                                {% if item.open %}open{% endif %}
                            >
                                <summary class="luxury-faq__question">
                                    <h3>
                                        {{ item.question }}
                                    </h3>

                                    <span class="luxury-faq__icon">
                                        <span class="luxury-faq__icon-border"></span>
                                        <span class="luxury-faq__icon-bg"></span>

                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2.5"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M19 9l-7 7-7-7"
                                            />
                                        </svg>
                                    </span>
                                </summary>

                                <div class="luxury-faq__answer">
                                    {{ item.answer }}
                                </div>
                            </details>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            {# Cta #}
            {% if component.show_cta %}
                <div class="luxury-faq__cta">
                    {% if component.cta_text %}
                        <p>
                            {{ component.cta_text }}
                        </p>
                    {% endif %}

                    {% if component.cta_button_text %}
                        <a
                            href="{{ component.cta_url ?: '#' }}"
                            class="luxury-faq__cta-button"
                        >
                            <span>←</span>
                            {{ component.cta_button_text }}
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>
{% endif %}