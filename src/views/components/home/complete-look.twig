{% if component.products|length %}

<section
class="luxury-look-section"
style="
--look-bg:{{ component.background_color ?: '#E62973' }};
padding:{{ component.section_padding ?: 80 }}px 0;
"
>

<div class="container">

<!-- HEADER -->
<div class="luxury-look-header">
{% if component.badge %}
<div class="badge">
{{ component.badge }}
</div>
{% endif %}

<h2>
{{ component.title ?: 'أكملي إطلالتك بأسلوب راقٍ' }}
</h2>

{% if component.description %}
<p>
{{ component.description }}
</p>
{% endif %}
</div>

<!-- CONTENT -->
<div class="luxury-look-content">

<!-- MAIN IMAGE -->
{% if component.show_image != false %}
<div class="luxury-look-image">
{% set img_url = '' %}
{% if component.main_image is iterable %}
{% set img_url = component.main_image.url ?: component.main_image.path %}
{% else %}
{% set img_url = component.main_image %}
{% endif %}

{% if img_url %}
<img
src="{{ img_url }}"
alt="{{ component.title ?: 'Luxury Look' }}"
loading="lazy"
decoding="async"
>
{% else %}
<div style="
height:100%;
display:flex;
align-items:center;
justify-content:center;
background:#222;
color:#fff;
font-size:22px;
font-weight:bold;
">
إطلالة فاخرة
</div>
{% endif %}
</div>
{% endif %}

<!-- PRODUCTS -->
<div class="luxury-products-box" style="{% if component.card_background %}background-color: {{ component.card_background }};{% endif %}">

<div class="luxury-products-title">
مكونات الإطلالة
</div>

<div class="luxury-products-list">
{% for product in component.products %}
<div class="luxury-product-item">

<div class="luxury-product-info">
{% if component.show_product_image != false %}
<a href="{{ product.url }}">
<img
src="{{ product.image.url ?: product.image }}"
alt="{{ product.name }}"
loading="lazy"
decoding="async"
>
</a>
{% endif %}

<div>
<a href="{{ product.url }}">
<div class="luxury-product-name">
{{ product.name }}
</div>
</a>

<div class="luxury-product-type">
قطعة أساسية
</div>
</div>
</div>

{% if component.show_product_price != false %}
<div class="luxury-product-price">
{{ product.price|money }}
</div>
{% endif %}

</div>
{% endfor %}
</div>

<!-- FOOTER -->
<div class="luxury-look-footer">

{% if component.show_total != false %}
<div>
<div class="luxury-total-label">
إجمالي الإطلالة
</div>
<div class="luxury-total-price">
{{ component.products|length }} منتجات
</div>
</div>
{% endif %}

{% if component.show_button != false %}
<div class="luxury-add-button luxury-cart-wrapper">
<button 
class="btn btn-primary luxury-cart-button-content" 
style="{% if component.button_color %}color: {{ component.button_color }};{% endif %}"
onclick="addLookToCart({{ component.products|map(p => p.id)|json_encode }})"
>
<span class="luxury-cart-icon"><i class="sicon-shopping-bag"></i></span>
<span>إضافة الإطلالة للسلة</span>
</button>
</div>
{% endif %}

</div>

</div>

</div>

</div>
</section>

{% endif %}