{% if component.products|length %}
<section
    class="luxury-look-section {% if component.enable_animation %}luxury-look-section--animated{% endif %}"
    style="
        --look-bg: {{ component.background_color ?: '#E62973' }};
        --look-accent: {{ component.accent_color ?: '#FFFFFF' }};
        padding-top: {{ component.section_padding ?: 80 }}px;
        padding-bottom: {{ component.section_padding ?: 80 }}px;
    "
>
    {# Background Decor #}
    <div class="luxury-look-bg" aria-hidden="true">
        <span class="luxury-look-bg__orb luxury-look-bg__orb--one"></span>
        <span class="luxury-look-bg__orb luxury-look-bg__orb--two"></span>
        <span class="luxury-look-bg__orb luxury-look-bg__orb--three"></span>
        <span class="luxury-look-bg__grid"></span>
    </div>

    <div class="container">
        {# Header #}
        <div class="luxury-look-header">
            {% if component.badge or component.show_badge != false %}
                <div class="luxury-look-header__badge">
                    <span class="luxury-look-header__badge-dot"></span>
                    <span>{{ component.badge ?: 'أناقة نسائية فاخرة' }}</span>
                </div>
            {% endif %}

            <h2>{{ component.title ?: 'أكملي إطلالتك بأسلوب راقٍ' }}</h2>
            <p>{{ component.description ?: 'اختاري القطع المثالية لإطلالة متكاملة' }}</p>

            <span class="luxury-look-header__line" aria-hidden="true"></span>
        </div>

        {# Main Content #}
        <div class="luxury-look-content">
            {# Image #}
            <div class="luxury-look-image">
                <div class="luxury-look-image__shine" aria-hidden="true"></div>
                <div class="luxury-look-image__frame" aria-hidden="true"></div>

                {% if component.main_image %}
                    <img
                        src="{{ component.main_image }}"
                        alt="{{ component.title ?: 'الإطلالة المتكاملة الفاخرة' }}"
                        loading="lazy"
                        decoding="async"
                    >
                {% else %}
                    <div class="luxury-look-placeholder">إطلالة فاخرة</div>
                {% endif %}

                <div class="luxury-look-image__caption" aria-hidden="true">
                    <span></span>
                    <small>THE COMPLETE LOOK</small>
                    <span></span>
                </div>
            </div>

            {# Products Box #}
            <div class="luxury-products-box">
                <div class="luxury-products-header">
                    <div>
                        <span class="luxury-products-header__eyebrow">COLLECTION</span>
                        <div class="luxury-products-title">مكونات الإطلالة</div>
                    </div>
                    <span class="luxury-products-count" aria-hidden="true">
                        {{ component.products|length }}
                    </span>
                </div>

                {# Products List #}
                <div class="luxury-products-list">
                    {% for product in component.products %}
                        <div
                            class="luxury-product-item {% if component.enable_animation %}luxury-product-item--animated{% endif %}"
                            style="--product-index: {{ loop.index0 }};"
                        >
                            <div class="luxury-product-item__number">
                                {{ '%02d'|format(loop.index) }}
                            </div>

                            <div class="luxury-product-info">
                                <a href="{{ product.url ?: '#' }}" aria-label="{{ product.name }}" class="luxury-product-image-link">
                                    <img
                                        src="{{ product.image.url ?: (product.image ?: 'images/placeholder.png'|asset) }}"
                                        alt="{{ product.name }}"
                                        loading="lazy"
                                        decoding="async"
                                    >
                                    <span class="luxury-product-image-glow" aria-hidden="true"></span>
                                </a>

                                <div class="luxury-product-details">
                                    <a href="{{ product.url ?: '#' }}" aria-label="{{ product.name }}">
                                        <div class="luxury-product-name">{{ product.name }}</div>
                                    </a>
                                    <div class="luxury-product-type">قطعة أساسية</div>
                                </div>
                            </div>

                            {% if component.show_product_price != false %}
                                <div class="luxury-product-price">
                                    {{ product.price|money }}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                {# Footer #}
                <div class="luxury-look-footer">
                    {% if component.show_total != false %}
                        <div class="luxury-look-total">
                            <div class="luxury-total-label">إجمالي الإطلالة</div>
                            <div class="luxury-total-price">
                                {{ component.products|length }} <span>منتجات</span>
                            </div>
                        </div>
                    {% endif %}

                    {% if component.show_button != false %}
                        <div class="luxury-add-button luxury-cart-wrapper">
                            {# يمكن تخصيص السلوك عبر JavaScript لإضافة المنتجات دفعة واحدة #}
                            <button class="btn btn-primary luxury-cart-button-content" onclick="addLookToCart({{ component.products|map(p => p.id)|json_encode }})">
                                <span class="luxury-cart-icon"><i class="sicon-shopping-bag"></i></span>
                                <span>إضافة الإطلالة للسلة</span>
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}