{# =========================================================
   LUXURY FOOTER
   الفوتر الفاخر
   Compatible with current Luxury Footer JSON
========================================================= #}

<footer
    class="
        luxury-footer

        {% if component.enable_animation %}
            luxury-footer--animated
        {% endif %}

        {% if component.show_glow %}
            luxury-footer--glow
        {% endif %}
    "
    style="
        --footer-bg: {{ component.background_color ?: '#171116' }};
        --footer-accent: {{ component.accent_color ?: '#E62973' }};
        --footer-card: {{ component.card_color ?: '#211A20' }};
        --footer-text: {{ component.text_color ?: '#FFFFFF' }};
        --footer-muted: {{ component.muted_color ?: '#B8AEB4' }};
        --footer-padding: {{ component.section_padding ?: '80' }}px;
    "
>

    {# =====================================================
       BACKGROUND DECORATION
    ===================================================== #}

    {% if component.show_glow %}

        <div
            class="luxury-footer__glow luxury-footer__glow--one"
            aria-hidden="true"
        ></div>

        <div
            class="luxury-footer__glow luxury-footer__glow--two"
            aria-hidden="true"
        ></div>

        <div
            class="luxury-footer__glow luxury-footer__glow--three"
            aria-hidden="true"
        ></div>

    {% endif %}


    {# =====================================================
       TOP DECORATIVE LINE
    ===================================================== #}

    <div
        class="luxury-footer__top-line"
        aria-hidden="true"
    >
        <span></span>
        <i class="sicon-award-ribbon"></i>
        <span></span>
    </div>


    {# =====================================================
       MAIN CONTAINER
    ===================================================== #}

    <div class="container luxury-footer__container">


        {# =================================================
           INTRO / BRAND AREA
        ================================================= #}

        <div class="luxury-footer__intro">


            {# Eyebrow #}

            {% if component.show_eyebrow and component.eyebrow %}

                <div class="luxury-footer__eyebrow">

                    <span class="luxury-footer__eyebrow-line"></span>

                    <span class="luxury-footer__eyebrow-text">
                        {{ component.eyebrow }}
                    </span>

                    <span class="luxury-footer__eyebrow-line"></span>

                </div>

            {% endif %}


            {# Title #}

            {% if component.show_title and component.title %}

                <h2 class="luxury-footer__title">

                    {{ component.title }}

                </h2>

            {% endif %}


            {# Description #}

            {% if component.show_description and component.description %}

                <p class="luxury-footer__description">

                    {{ component.description }}

                </p>

            {% endif %}


        </div>


        {# =================================================
           FOOTER MAIN GRID
        ================================================= #}

        <div class="luxury-footer__grid">


            {# =================================================
               COLUMN 1
               المتجر
            ================================================= #}

            <div class="luxury-footer__column luxury-footer__column--brand">


                <div class="luxury-footer__brand-mark">

                    <span class="luxury-footer__brand-symbol">

                        <i class="sicon-award-ribbon"></i>

                    </span>

                    <span class="luxury-footer__brand-line"></span>

                </div>


                <div class="luxury-footer__column-title">

                    {{ component.eyebrow ?: 'تجربة فاخرة' }}

                </div>


                <p class="luxury-footer__column-description">

                    {{ component.description ?: 'تجربة تسوق مصممة بعناية لتمنحك الأناقة والجودة في كل تفصيل.' }}

                </p>


            </div>


            {# =================================================
               COLUMN 2
               روابط المتجر
            ================================================= #}

            <div class="luxury-footer__column">


                <h3 class="luxury-footer__column-title">

                    تسوق معنا

                </h3>


                <nav
                    class="luxury-footer__links"
                    aria-label="روابط التسوق"
                >

                    <a href="{{ link('/') }}">
                        الرئيسية
                    </a>

                    <a href="{{ link('products') }}">
                        المنتجات
                    </a>

                    <a href="{{ link('brands') }}">
                        الماركات
                    </a>

                    <a href="{{ link('categories') }}">
                        التصنيفات
                    </a>

                </nav>


            </div>


            {# =================================================
               COLUMN 3
               خدمة العملاء
            ================================================= #}

            <div class="luxury-footer__column">


                <h3 class="luxury-footer__column-title">

                    خدمة العملاء

                </h3>


                <nav
                    class="luxury-footer__links"
                    aria-label="روابط خدمة العملاء"
                >

                    <a href="{{ component.terms_url ?: '#' }}">
                        الشروط والأحكام
                    </a>

                    <a href="{{ component.privacy_url ?: '#' }}">
                        سياسة الخصوصية
                    </a>

                    <a href="{{ component.returns_url ?: '#' }}">
                        الاستبدال والاسترجاع
                    </a>

                    <a href="#contact">
                        تواصل معنا
                    </a>

                </nav>


            </div>


            {# =================================================
               COLUMN 4
               NEWSLETTER / SOCIAL
            ================================================= #}

            <div class="luxury-footer__column luxury-footer__column--contact">


                {% if component.show_newsletter %}

                    <div class="luxury-footer__newsletter">


                        <h3 class="luxury-footer__column-title">

                            ابقي على اطلاع

                        </h3>


                        <p class="luxury-footer__newsletter-text">

                            اشتركي لتصلك أحدث المنتجات والعروض الحصرية.

                        </p>


                        <div class="luxury-footer__newsletter-form">

                            <input
                                type="email"
                                name="email"
                                placeholder="البريد الإلكتروني"
                                aria-label="البريد الإلكتروني"
                                autocomplete="email"
                            >

                            <button
                                type="button"
                                aria-label="الاشتراك في النشرة البريدية"
                            >

                                <i class="sicon-arrow-left"></i>

                            </button>

                        </div>


                    </div>

                {% endif %}


                {% if component.show_social %}

                    <div class="luxury-footer__social">


                        <span class="luxury-footer__social-title">

                            تابعينا

                        </span>


                        <div class="luxury-footer__social-list">


                            <a
                                href="#"
                                aria-label="Instagram"
                                class="luxury-footer__social-link"
                            >

                                <i class="sicon-instagram"></i>

                            </a>


                            <a
                                href="#"
                                aria-label="TikTok"
                                class="luxury-footer__social-link"
                            >

                                <i class="sicon-tiktok"></i>

                            </a>


                            <a
                                href="#"
                                aria-label="X"
                                class="luxury-footer__social-link"
                            >

                                <i class="sicon-twitter"></i>

                            </a>


                            <a
                                href="#"
                                aria-label="Facebook"
                                class="luxury-footer__social-link"
                            >

                                <i class="sicon-facebook"></i>

                            </a>


                        </div>


                    </div>

                {% endif %}


            </div>


        </div>


        {# =================================================
           PAYMENT METHODS
        ================================================= #}

        {% if component.show_payment %}

            <div class="luxury-footer__payment">


                <div class="luxury-footer__payment-heading">

                    <span class="luxury-footer__payment-title">

                        طرق دفع آمنة

                    </span>

                    <span class="luxury-footer__payment-subtitle">

                        دفع آمن وموثوق

                    </span>

                </div>


                <div class="luxury-footer__payment-list">


                    <span class="luxury-footer__payment-item">

                        <i class="sicon-credit-card"></i>

                    </span>


                    <span class="luxury-footer__payment-item">

                        VISA

                    </span>


                    <span class="luxury-footer__payment-item">

                        MASTERCARD

                    </span>


                    <span class="luxury-footer__payment-item">

                        <i class="sicon-lock"></i>

                    </span>


                </div>


            </div>

        {% endif %}


        {# =================================================
           DIVIDER
        ================================================= #}

        <div
            class="luxury-footer__divider"
            aria-hidden="true"
        ></div>


        {# =================================================
           BOTTOM BAR
        ================================================= #}

        <div class="luxury-footer__bottom">


            {# Copyright #}

            <div class="luxury-footer__copyright">

                <span>

                    ©

                </span>

                <span>

                    {{ "now"|date("Y") }}

                </span>

                <span>

                    {{ component.copyright ?: 'جميع الحقوق محفوظة' }}

                </span>

            </div>


            {# Legal Links #}

            {% if component.show_legal %}

                <nav
                    class="luxury-footer__legal"
                    aria-label="الروابط القانونية"
                >

                    {% if component.privacy_url %}

                        <a href="{{ component.privacy_url }}">

                            الخصوصية

                        </a>

                    {% endif %}


                    {% if component.terms_url %}

                        <a href="{{ component.terms_url }}">

                            الشروط

                        </a>

                    {% endif %}


                    {% if component.returns_url %}

                        <a href="{{ component.returns_url }}">

                            الاستبدال والاسترجاع

                        </a>

                    {% endif %}

                </nav>

            {% endif %}


            {# Back To Top #}

            <button
                type="button"
                class="luxury-footer__top"
                aria-label="العودة إلى أعلى الصفحة"
                onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
            >

                <i class="sicon-arrow-up"></i>

            </button>


        </div>


    </div>


    {# =====================================================
       BOTTOM GLOW / DECORATION
    ===================================================== #}

    <div
        class="luxury-footer__bottom-decoration"
        aria-hidden="true"
    >

        <span></span>

        <i class="sicon-heart"></i>

        <span></span>

    </div>


</footer>
