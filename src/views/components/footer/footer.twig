{# =========================================================
   LUXURY FOOTER
   يعتمد على theme.settings
========================================================= #}

{% set footer_show_description = theme.settings.get('footer_show_description', true) %}
{% set footer_description = theme.settings.get('footer_description', '') %}

{% set footer_show_social = theme.settings.get('footer_show_social', true) %}
{% set footer_social_links = theme.settings.get('footer_social_links', []) %}

{% set footer_show_links = theme.settings.get('footer_show_links', true) %}
{% set footer_links_title = theme.settings.get('footer_links_title', 'روابط مهمة') %}
{% set footer_links = theme.settings.get('footer_links', []) %}

{% set footer_show_contact = theme.settings.get('footer_show_contact', true) %}
{% set footer_contact_title = theme.settings.get('footer_contact_title', 'تواصل معنا') %}
{% set footer_phone = theme.settings.get('footer_phone', '') %}
{% set footer_email = theme.settings.get('footer_email', '') %}
{% set footer_whatsapp = theme.settings.get('footer_whatsapp', '') %}
{% set footer_location = theme.settings.get('footer_location', '') %}

{% set footer_show_apps = theme.settings.get('footer_show_apps', true) %}
{% set footer_apps_title = theme.settings.get('footer_apps_title', 'تطبيق الجوال') %}
{% set footer_apple_url = theme.settings.get('footer_apple_url', '') %}
{% set footer_google_url = theme.settings.get('footer_google_url', '') %}

{% set footer_show_scroll_top = theme.settings.get('footer_show_scroll_top', true) %}

{% set footer_copyright = theme.settings.get('footer_copyright', '© 2026 جميع الحقوق محفوظة') %}
{% set footer_brand_name = theme.settings.get('footer_brand_name', store.name) %}
{% set footer_credit = theme.settings.get('footer_credit', '') %}

{% set footer_background_color = theme.settings.get('footer_background_color', '#0B0A0C') %}
{% set footer_text_color = theme.settings.get('footer_text_color', '#A1A1AA') %}
{% set footer_title_color = theme.settings.get('footer_title_color', '#FFFFFF') %}
{% set footer_accent_color = theme.settings.get('footer_accent_color', '#E62973') %}
{% set footer_border_color = theme.settings.get('footer_border_color', '#E6297333') %}

{% set footer_show_glow = theme.settings.get('footer_show_glow', true) %}
{% set footer_show_pattern = theme.settings.get('footer_show_pattern', true) %}


<footer
    class="luxury-footer"
    dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}"
    style="
        --footer-bg: {{ footer_background_color }};
        --footer-text: {{ footer_text_color }};
        --footer-title: {{ footer_title_color }};
        --footer-accent: {{ footer_accent_color }};
        --footer-border: {{ footer_border_color }};
    "
>

    {# =====================================================
       BACKGROUND
    ===================================================== #}

    <div class="luxury-footer__background" aria-hidden="true">

        <span class="luxury-footer__line"></span>

        {% if footer_show_glow %}
            <span class="luxury-footer__glow luxury-footer__glow--one"></span>
            <span class="luxury-footer__glow luxury-footer__glow--two"></span>
        {% endif %}

        {% if footer_show_pattern %}
            <span class="luxury-footer__pattern"></span>
        {% endif %}

    </div>


    <div class="luxury-footer__container container">


        {# =================================================
           TOP INTRO
        ================================================= #}

        <div class="luxury-footer__intro">

            <div class="luxury-footer__brand">

                {# الشعار من store.logo #}

                {% if store.logo %}

                    <a
                        href="{{ store.url }}"
                        class="luxury-footer__logo"
                        aria-label="{{ store.name }}"
                    >
                        <img
                            src="{{ store.logo }}"
                            alt="{{ store.name }}"
                            loading="lazy"
                            decoding="async"
                        >
                    </a>

                {% else %}

                    <a
                        href="{{ store.url }}"
                        class="luxury-footer__brand-name"
                    >
                        {{ store.name }}
                    </a>

                {% endif %}

            </div>


            {% if footer_show_description and footer_description %}

                <p class="luxury-footer__description">
                    {{ footer_description }}
                </p>

            {% endif %}


            {# SOCIAL #}

            {% if footer_show_social and footer_social_links|length %}

                <div class="luxury-footer__social">

                    {% for social in footer_social_links %}

                        {% if social.url %}

                            <a
                                href="{{ social.url }}"
                                class="luxury-footer__social-link"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="{{ social.name ?: 'Social media' }}"
                            >

                                {% if social.icon %}
                                    <i class="{{ social.icon }}"></i>
                                {% else %}
                                    <span>
                                        {{ social.name|slice(0, 1) }}
                                    </span>
                                {% endif %}

                            </a>

                        {% endif %}

                    {% endfor %}

                </div>

            {% endif %}

        </div>


        {# =================================================
           MAIN GRID
        ================================================= #}

        <div class="luxury-footer__grid">


            {# =================================================
               LINKS
            ================================================= #}

            {% if footer_show_links and footer_links|length %}

                <div class="luxury-footer__column">

                    <h3 class="luxury-footer__heading">
                        {{ footer_links_title }}
                    </h3>

                    <span class="luxury-footer__heading-line"></span>

                    <ul class="luxury-footer__links">

                        {% for link in footer_links %}

                            {% if link.url %}

                                <li>
                                    <a href="{{ link.url }}">
                                        <span>{{ link.title }}</span>
                                        <i class="sicon-arrow-left"></i>
                                    </a>
                                </li>

                            {% endif %}

                        {% endfor %}

                    </ul>

                </div>

            {% endif %}


            {# =================================================
               CONTACT
            ================================================= #}

            {% if footer_show_contact %}

                <div class="luxury-footer__column">

                    <h3 class="luxury-footer__heading">
                        {{ footer_contact_title }}
                    </h3>

                    <span class="luxury-footer__heading-line"></span>

                    <div class="luxury-footer__contact">

                        {% if footer_phone %}

                            <a
                                href="tel:{{ footer_phone }}"
                                class="luxury-footer__contact-item"
                            >
                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-phone"></i>
                                </span>

                                <span>
                                    {{ footer_phone }}
                                </span>
                            </a>

                        {% endif %}


                        {% if footer_email %}

                            <a
                                href="mailto:{{ footer_email }}"
                                class="luxury-footer__contact-item"
                            >
                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-mail"></i>
                                </span>

                                <span>
                                    {{ footer_email }}
                                </span>
                            </a>

                        {% endif %}


                        {% if footer_whatsapp %}

                            <a
                                href="{{ footer_whatsapp }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="luxury-footer__contact-item"
                            >
                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-whatsapp"></i>
                                </span>

                                <span>
                                    واتساب
                                </span>
                            </a>

                        {% endif %}


                        {% if footer_location %}

                            <div class="luxury-footer__contact-item">

                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-location"></i>
                                </span>

                                <span>
                                    {{ footer_location }}
                                </span>

                            </div>

                        {% endif %}

                    </div>

                </div>

            {% endif %}


            {# =================================================
               MOBILE APPS
            ================================================= #}

            {% if footer_show_apps %}

                <div class="luxury-footer__column">

                    <h3 class="luxury-footer__heading">
                        {{ footer_apps_title }}
                    </h3>

                    <span class="luxury-footer__heading-line"></span>

                    <div class="luxury-footer__apps">


                        {% if footer_apple_url %}

                            <a
                                href="{{ footer_apple_url }}"
                                class="luxury-footer__app"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img
                                    src="{{ 'images/app-store.svg'|asset }}"
                                    alt="App Store"
                                    loading="lazy"
                                >
                            </a>

                        {% endif %}


                        {% if footer_google_url %}

                            <a
                                href="{{ footer_google_url }}"
                                class="luxury-footer__app"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <img
                                    src="{{ 'images/google-play.svg'|asset }}"
                                    alt="Google Play"
                                    loading="lazy"
                                >
                            </a>

                        {% endif %}

                    </div>

                </div>

            {% endif %}

        </div>


        {# =================================================
           LEGAL LINKS
        ================================================= #}

        <div class="luxury-footer__legal">

            <a href="{{ theme.settings.get('footer_terms_url', '#') }}">
                الشروط والأحكام
            </a>

            <span></span>

            <a href="{{ theme.settings.get('footer_privacy_url', '#') }}">
                سياسة الخصوصية
            </a>

            <span></span>

            <a href="{{ theme.settings.get('footer_returns_url', '#') }}">
                الاستبدال والاسترجاع
            </a>

        </div>


        {# =================================================
           BOTTOM
        ================================================= #}

        <div class="luxury-footer__bottom">

            <div class="luxury-footer__copyright">

                {{ footer_copyright }}

                {% if footer_brand_name %}
                    <strong>{{ footer_brand_name }}</strong>
                {% endif %}

            </div>


            {% if footer_credit %}

                <div class="luxury-footer__credit">
                    {{ footer_credit }}
                </div>

            {% endif %}

        </div>

    </div>


    {# =====================================================
       SCROLL TOP
    ===================================================== #}

    {% if footer_show_scroll_top %}

        <button
            type="button"
            class="luxury-footer__scroll-top"
            aria-label="العودة إلى الأعلى"
            onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
        >
            <i class="sicon-arrow-up"></i>
        </button>

    {% endif %}

</footer>
