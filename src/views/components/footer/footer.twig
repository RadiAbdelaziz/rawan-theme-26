{# =========================================================
   LUXURY FOOTER
   الفوتر الفاخر
   آخر عنصر في الصفحة
========================================================= #}

<footer
    class="
        luxury-footer
        {% if component.enable_animation %}
            luxury-footer--animated
        {% endif %}
    "
    dir="rtl"
    style="
        --footer-bg: {{ component.background_color ?: '#0B0A0C' }};
        --footer-accent: {{ component.accent_color ?: '#E62973' }};
        --footer-text: {{ component.text_color ?: '#D4D4D8' }};
        --footer-muted: {{ component.muted_color ?: '#71717A' }};
        --footer-padding: {{ component.section_padding ?: 80 }}px;
    "
>

    {# =====================================================
       BACKGROUND EFFECTS
    ===================================================== #}

    <div
        class="luxury-footer__background"
        aria-hidden="true"
    >

        <span class="luxury-footer__line"></span>

        {% if component.show_glow %}

            <span class="luxury-footer__glow luxury-footer__glow--one"></span>

            <span class="luxury-footer__glow luxury-footer__glow--two"></span>

            <span class="luxury-footer__glow luxury-footer__glow--center"></span>

        {% endif %}

        <span class="luxury-footer__pattern"></span>

    </div>


    {# =====================================================
       MAIN CONTAINER
    ===================================================== #}

    <div class="container luxury-footer__container">


        {# =================================================
           TOP CONTENT
        ================================================= #}

        <div class="luxury-footer__top">


            {# =================================================
               BRAND
            ================================================= #}

            <div class="luxury-footer__brand">


                {% if component.show_logo %}

                    <a
                        href="{{ '#' }}"
                        class="luxury-footer__brand-link"
                        aria-label="{{ component.store_name ?: 'المتجر' }}"
                    >

                        <span class="luxury-footer__logo">

                            {{ component.logo_letter ?: 'ر' }}

                        </span>


                        <span class="luxury-footer__brand-content">

                            {% if component.store_name %}

                                <span class="luxury-footer__store-name">

                                    {{ component.store_name }}

                                </span>

                            {% endif %}


                            {% if component.brand_caption %}

                                <span class="luxury-footer__caption">

                                    {{ component.brand_caption }}

                                </span>

                            {% endif %}

                        </span>

                    </a>

                {% endif %}


                {% if component.show_description and component.store_description %}

                    <p class="luxury-footer__description">

                        {{ component.store_description }}

                    </p>

                {% endif %}


                {# =================================================
                   SOCIAL MEDIA
                ================================================= #}

                <div class="luxury-footer__social">


                    {% if component.show_instagram and component.instagram_url %}

                        <a
                            href="{{ component.instagram_url }}"
                            class="luxury-footer__social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram"
                        >

                            <span class="luxury-footer__social-icon">
                                <i class="sicon-instagram"></i>
                            </span>

                        </a>

                    {% endif %}


                    {% if component.show_tiktok and component.tiktok_url %}

                        <a
                            href="{{ component.tiktok_url }}"
                            class="luxury-footer__social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="TikTok"
                        >

                            <span class="luxury-footer__social-icon">
                                <i class="sicon-tiktok"></i>
                            </span>

                        </a>

                    {% endif %}


                    {% if component.show_x and component.x_url %}

                        <a
                            href="{{ component.x_url }}"
                            class="luxury-footer__social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="X"
                        >

                            <span class="luxury-footer__social-icon">
                                <i class="sicon-twitter"></i>
                            </span>

                        </a>

                    {% endif %}


                    {% if component.show_youtube and component.youtube_url %}

                        <a
                            href="{{ component.youtube_url }}"
                            class="luxury-footer__social-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="YouTube"
                        >

                            <span class="luxury-footer__social-icon">
                                <i class="sicon-youtube"></i>
                            </span>

                        </a>

                    {% endif %}


                </div>

            </div>


            {# =================================================
               IMPORTANT LINKS
            ================================================= #}

            {% if component.show_links %}

                <div class="luxury-footer__column">


                    {% if component.links_title %}

                        <h3 class="luxury-footer__heading">

                            <span>
                                {{ component.links_title }}
                            </span>

                        </h3>

                    {% endif %}


                    {% if component.links|length %}

                        <ul class="luxury-footer__links">

                            {% for link in component.links %}

                                {% set link_name = link.name ?: link.title ?: 'رابط' %}

                                {% set link_url = link.url ?: link.link ?: '#' %}

                                <li>

                                    <a
                                        href="{{ link_url }}"
                                        class="luxury-footer__link"
                                    >

                                        <span class="luxury-footer__link-dot"></span>

                                        <span>
                                            {{ link_name }}
                                        </span>

                                    </a>

                                </li>

                            {% endfor %}

                        </ul>

                    {% endif %}

                </div>

            {% endif %}


            {# =================================================
               CONTACT
            ================================================= #}

            {% if component.show_contact %}

                <div class="luxury-footer__column">


                    {% if component.contact_title %}

                        <h3 class="luxury-footer__heading">

                            <span>
                                {{ component.contact_title }}
                            </span>

                        </h3>

                    {% endif %}


                    <div class="luxury-footer__contact">


                        {% if component.phone %}

                            <a
                                href="tel:{{ component.phone }}"
                                class="luxury-footer__contact-item"
                            >

                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-phone"></i>
                                </span>

                                <span class="luxury-footer__contact-value">

                                    {{ component.phone }}

                                </span>

                            </a>

                        {% endif %}


                        {% if component.email %}

                            <a
                                href="mailto:{{ component.email }}"
                                class="luxury-footer__contact-item"
                            >

                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-envelope"></i>
                                </span>

                                <span class="luxury-footer__contact-value">

                                    {{ component.email }}

                                </span>

                            </a>

                        {% endif %}


                        {% if component.address %}

                            <div class="luxury-footer__contact-item">

                                <span class="luxury-footer__contact-icon">
                                    <i class="sicon-location"></i>
                                </span>

                                <span class="luxury-footer__contact-value">

                                    {{ component.address }}

                                </span>

                            </div>

                        {% endif %}


                    </div>

                </div>

            {% endif %}


            {# =================================================
               MOBILE APPLICATIONS
            ================================================= #}

            {% if component.show_apps %}

                <div class="luxury-footer__column luxury-footer__apps">


                    {% if component.apps_title %}

                        <h3 class="luxury-footer__heading">

                            <span>
                                {{ component.apps_title }}
                            </span>

                        </h3>

                    {% endif %}


                    <div class="luxury-footer__app-links">


                        {% if component.apple_store_url %}

                            <a
                                href="{{ component.apple_store_url }}"
                                class="luxury-footer__app-link"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="App Store"
                            >

                                <span class="luxury-footer__app-icon">
                                    
                                </span>

                                <span>

                                    <small>
                                        Download on the
                                    </small>

                                    <strong>
                                        App Store
                                    </strong>

                                </span>

                            </a>

                        {% endif %}


                        {% if component.google_play_url %}

                            <a
                                href="{{ component.google_play_url }}"
                                class="luxury-footer__app-link"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Google Play"
                            >

                                <span class="luxury-footer__app-icon">
                                    ▶
                                </span>

                                <span>

                                    <small>
                                        GET IT ON
                                    </small>

                                    <strong>
                                        Google Play
                                    </strong>

                                </span>

                            </a>

                        {% endif %}


                    </div>

                </div>

            {% endif %}


        </div>


        {# =================================================
           DIVIDER
        ================================================= #}

        <div
            class="luxury-footer__divider"
            aria-hidden="true"
        >

            <span></span>

            <i class="sicon-heart"></i>

            <span></span>

        </div>


        {# =================================================
           BOTTOM
        ================================================= #}

        <div class="luxury-footer__bottom">


            {% if component.show_copyright %}

                <div class="luxury-footer__copyright">

                    <span>

                        © {{ "now"|date("Y") }}

                    </span>

                    <span>

                        {{ component.copyright_text ?: 'جميع الحقوق محفوظة' }}

                    </span>

                    {% if component.store_name %}

                        <strong>

                            {{ component.store_name }}

                        </strong>

                    {% endif %}

                </div>

            {% endif %}


            {% if component.designer_text %}

                <div class="luxury-footer__designer">

                    {{ component.designer_text }}

                </div>

            {% endif %}

        </div>

    </div>


    {# =====================================================
       SCROLL TOP
       لا يحجز مساحة من الصفحة
    ===================================================== #}

    {% if component.show_scroll_top %}

        <button
            type="button"
            class="luxury-footer__scroll-top"
            aria-label="العودة إلى أعلى الصفحة"
            data-luxury-scroll-top
        >

            <i class="sicon-arrow-up"></i>

        </button>

    {% endif %}

</footer>
