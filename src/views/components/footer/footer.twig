{# =========================================================
   FOOTER SETTINGS + FALLBACKS
   ========================================================= #}

{% set footer_show_description = theme.settings.get('footer_show_description') %}
{% set footer_description = theme.settings.get('footer_description') %}

{% set footer_show_social = theme.settings.get('footer_show_social') %}
{% set footer_social_links = theme.settings.get('footer_social_links') %}

{% set footer_show_links = theme.settings.get('footer_show_links') %}
{% set footer_links_title = theme.settings.get('footer_links_title') %}
{% set footer_links = theme.settings.get('footer_links') %}

{% set footer_show_contact = theme.settings.get('footer_show_contact') %}
{% set footer_contact_title = theme.settings.get('footer_contact_title') %}
{% set footer_phone = theme.settings.get('footer_phone') %}
{% set footer_email = theme.settings.get('footer_email') %}
{% set footer_whatsapp = theme.settings.get('footer_whatsapp') %}
{% set footer_location = theme.settings.get('footer_location') %}

{% set footer_show_apps = theme.settings.get('footer_show_apps') %}
{% set footer_apps_title = theme.settings.get('footer_apps_title') %}
{% set footer_apple_url = theme.settings.get('footer_apple_url') %}
{% set footer_google_url = theme.settings.get('footer_google_url') %}

{% set footer_show_scroll_top = theme.settings.get('footer_show_scroll_top') %}

{% set footer_copyright = theme.settings.get('footer_copyright') %}
{% set footer_brand_name = theme.settings.get('footer_brand_name') %}
{% set footer_credit = theme.settings.get('footer_credit') %}

{% set footer_background_color = theme.settings.get('footer_background_color') %}
{% set footer_text_color = theme.settings.get('footer_text_color') %}
{% set footer_title_color = theme.settings.get('footer_title_color') %}
{% set footer_accent_color = theme.settings.get('footer_accent_color') %}
{% set footer_border_color = theme.settings.get('footer_border_color') %}

{% set footer_show_glow = theme.settings.get('footer_show_glow') %}
{% set footer_show_pattern = theme.settings.get('footer_show_pattern') %}


{# =========================================================
   FALLBACK VALUES
   ========================================================= #}

{% set footer_description =
    footer_description
    ?: 'روان هي تجربة تسوق تجمع بين الجودة وحسن الاختيار، مع منتجات مختارة بعناية وتجربة مصممة لتمنحك ثقة أكبر في كل طلب.'
%}

{% set footer_links_title =
    footer_links_title
    ?: 'روابط مهمة'
%}

{% set footer_contact_title =
    footer_contact_title
    ?: 'تواصل معنا'
%}

{% set footer_apps_title =
    footer_apps_title
    ?: 'تطبيق الجوال'
%}

{% set footer_copyright =
    footer_copyright
    ?: '© 2026 جميع الحقوق محفوظة'
%}

{% set footer_brand_name =
    footer_brand_name
    ?: store.name
%}

{% set footer_credit =
    footer_credit
    ?: 'جودة تبدأ في الاختيار، وثقة تُبنى مع كل تجربة.'
%}

{% set footer_location =
    footer_location
    ?: ''
%}


{# =========================================================
   VISIBILITY FALLBACKS
   إذا لم يتم إعدادها من لوحة التحكم
   ========================================================= #}

{% if footer_show_description is null %}
    {% set footer_show_description = true %}
{% endif %}

{% if footer_show_links is null %}
    {% set footer_show_links = true %}
{% endif %}

{% if footer_show_contact is null %}
    {% set footer_show_contact = true %}
{% endif %}

{% if footer_show_social is null %}
    {% set footer_show_social = true %}
{% endif %}

{% if footer_show_apps is null %}
    {% set footer_show_apps = false %}
{% endif %}

{% if footer_show_scroll_top is null %}
    {% set footer_show_scroll_top = true %}
{% endif %}

{% if footer_show_glow is null %}
    {% set footer_show_glow = true %}
{% endif %}

{% if footer_show_pattern is null %}
    {% set footer_show_pattern = true %}
{% endif %}


{# =========================================================
   FOOTER
   ========================================================= #}

<footer
    class="custom-footer"
    dir="rtl"
    style="
        --footer-bg: {{ footer_background_color ?: '#0B0A0C' }};
        --footer-text: {{ footer_text_color ?: '#A1A1AA' }};
        --footer-title: {{ footer_title_color ?: '#FFFFFF' }};
        --footer-accent: {{ footer_accent_color ?: '#E62973' }};
        --footer-border: {{ footer_border_color ?: '#E6297333' }};
    "
>

    {# =====================================================
       GLOW
       ===================================================== #}

    {% if footer_show_glow %}

        <div class="custom-footer__glow custom-footer__glow--top"></div>

        <div class="custom-footer__glow custom-footer__glow--bottom"></div>

    {% endif %}


    {# =====================================================
       BACKGROUND PATTERN
       ===================================================== #}

    {% if footer_show_pattern %}

        <div class="custom-footer__pattern"></div>

    {% endif %}


    <div class="container custom-footer__container">

        <div class="custom-footer__top">


            {# =================================================
               BRAND
               ================================================= #}

            <div class="custom-footer__brand">

                <a
                    href="{{ store.url }}"
                    class="custom-footer__logo"
                    aria-label="{{ store.name }}"
                >

                    {% if store.logo %}

                        <img
                            src="{{ store.logo }}"
                            alt="{{ store.name }}"
                            class="custom-footer__logo-image"
                        >

                    {% else %}

                        <span class="custom-footer__logo-fallback">
                            {{ store.name|slice(0, 1) }}
                        </span>

                    {% endif %}

                </a>


                {# =================================================
                   STORE DESCRIPTION
                   ================================================= #}

                {% if footer_show_description %}

                    <p class="custom-footer__description">
                        {{ footer_description }}
                    </p>

                {% endif %}


                {# =================================================
                   SOCIAL MEDIA
                   
                   تظهر فقط إذا:
                   1. تم تفعيلها.
                   2. توجد collection.
                   3. يوجد رابط فعلي.
                   4. توجد أيقونة فعلية.

                   لا توجد منصات ثابتة هنا.
                   المستخدم هو من يحدد المنصات التي تظهر.
                   ================================================= #}

                {% if footer_show_social and footer_social_links|length %}

                    <div class="custom-footer__social">

                        {% for social in footer_social_links %}

                            {% if social.url and social.icon %}

                                <a
                                    href="{{ social.url }}"
                                    class="custom-footer__social-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label="{{ social.name ?: 'التواصل الاجتماعي' }}"
                                    title="{{ social.name ?: 'التواصل الاجتماعي' }}"
                                >

                                    <i class="{{ social.icon }}"></i>

                                </a>

                            {% endif %}

                        {% endfor %}

                    </div>

                {% endif %}

            </div>



            {# =================================================
               IMPORTANT LINKS
               ================================================= #}

            {% if footer_show_links %}

                <div class="custom-footer__column">

                    <h3 class="custom-footer__title">
                        {{ footer_links_title }}
                    </h3>


                    {% if footer_links|length %}

                        <ul class="custom-footer__links">

                            {% for link in footer_links %}

                                {% if link.url and link.title %}

                                    <li>

                                        <a href="{{ link.url }}">

                                            <span>
                                                {{ link.title }}
                                            </span>

                                            <i class="sicon-arrow-left"></i>

                                        </a>

                                    </li>

                                {% endif %}

                            {% endfor %}

                        </ul>

                    {% else %}

                        {# لا نضع روابط وهمية #}

                        <div class="custom-footer__empty">

                            <span>
                                اكتشف متجرنا وتجربتنا
                            </span>

                            <a href="{{ store.url }}">

                                <span>
                                    زيارة المتجر
                                </span>

                                <i class="sicon-arrow-left"></i>

                            </a>

                        </div>

                    {% endif %}

                </div>

            {% endif %}



            {# =================================================
               CONTACT
               ================================================= #}

            {% if footer_show_contact %}

                <div class="custom-footer__column">

                    <h3 class="custom-footer__title">
                        {{ footer_contact_title }}
                    </h3>


                    <div class="custom-footer__contact">


                        {# PHONE #}

                        {% if footer_phone %}

                            <a
                                href="tel:{{ footer_phone }}"
                                class="custom-footer__contact-item"
                            >

                                <span>
                                    {{ footer_phone }}
                                </span>

                                <span class="custom-footer__contact-icon">
                                    <i class="sicon-phone"></i>
                                </span>

                            </a>

                        {% endif %}


                        {# EMAIL #}

                        {% if footer_email %}

                            <a
                                href="mailto:{{ footer_email }}"
                                class="custom-footer__contact-item"
                            >

                                <span>
                                    {{ footer_email }}
                                </span>

                                <span class="custom-footer__contact-icon">
                                    <i class="sicon-mail"></i>
                                </span>

                            </a>

                        {% endif %}


                        {# WHATSAPP #}

                        {% if footer_whatsapp %}

                            <a
                                href="{{ footer_whatsapp }}"
                                class="custom-footer__contact-item"
                                target="_blank"
                                rel="noopener noreferrer"
                            >

                                <span>
                                    واتساب
                                </span>

                                <span class="custom-footer__contact-icon">
                                    <i class="sicon-whatsapp"></i>
                                </span>

                            </a>

                        {% endif %}


                        {# LOCATION #}

                        {% if footer_location %}

                            <div class="custom-footer__contact-item">

                                <span>
                                    {{ footer_location }}
                                </span>

                                <span class="custom-footer__contact-icon">
                                    <i class="sicon-location"></i>
                                </span>

                            </div>

                        {% endif %}


                        {# NO CONTACT DATA #}

                        {% if not footer_phone
                            and not footer_email
                            and not footer_whatsapp
                            and not footer_location
                        %}

                            <div class="custom-footer__contact-placeholder">

                                <span class="custom-footer__contact-icon">
                                    <i class="sicon-headset"></i>
                                </span>

                                <span>
                                    فريقنا هنا لخدمتك
                                </span>

                            </div>

                        {% endif %}

                    </div>

                </div>

            {% endif %}



            {# =================================================
               MOBILE APPS
               تظهر فقط عند وجود رابط فعلي
               ================================================= #}

            {% if footer_show_apps and (footer_apple_url or footer_google_url) %}

                <div class="custom-footer__column">

                    <h3 class="custom-footer__title">
                        {{ footer_apps_title }}
                    </h3>


                    <div class="custom-footer__apps">


                        {# APP STORE #}

                        {% if footer_apple_url %}

                            <a
                                href="{{ footer_apple_url }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="custom-footer__app"
                            >

                                <span class="custom-footer__app-icon">
                                    <i class="sicon-apple"></i>
                                </span>

                                <span>

                                    <small>
                                        حمّل من
                                    </small>

                                    <strong>
                                        App Store
                                    </strong>

                                </span>

                            </a>

                        {% endif %}


                        {# GOOGLE PLAY #}

                        {% if footer_google_url %}

                            <a
                                href="{{ footer_google_url }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="custom-footer__app"
                            >

                                <span class="custom-footer__app-icon">
                                    <i class="sicon-google-play"></i>
                                </span>

                                <span>

                                    <small>
                                        متوفر على
                                    </small>

                                    <strong>
                                        Google Play
                                    </strong>

                                </span>

                            </a>

                        {% endif %}

                    </div>

                </div>

            {% endif %}


        </div>



        {# =================================================
           FOOTER BOTTOM
           ================================================= #}

        <div class="custom-footer__bottom">


            {# COPYRIGHT #}

            <div class="custom-footer__copyright">

                {% if footer_copyright %}

                    <span>
                        {{ footer_copyright }}
                    </span>

                {% endif %}


                {% if footer_brand_name %}

                    <strong>
                        {{ footer_brand_name }}
                    </strong>

                {% endif %}

            </div>


            {# CREDIT #}

            {% if footer_credit %}

                <div class="custom-footer__credit">

                    {{ footer_credit }}

                </div>

            {% endif %}


        </div>

    </div>



    {# =========================================================
       SCROLL TO TOP
       ========================================================= #}

    {% if footer_show_scroll_top %}

        <button
            type="button"
            class="custom-footer__scroll-top"
            aria-label="العودة إلى أعلى الصفحة"
            onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        >

            <i class="sicon-arrow-up"></i>

        </button>

    {% endif %}


</footer>