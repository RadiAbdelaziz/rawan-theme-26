{# =========================================================
   LUXURY FOOTER
   الفوتر الفاخر
   Built strictly from current JSON fields
========================================================= #}

<footer
    class="
        luxury-footer
        {% if component.enable_animation %}
            luxury-footer--animated
        {% endif %}
        {% if component.show_glow %}
            luxury-footer--glow
        {% endif %}
    "
    style="
        --footer-bg: {{ component.background_color ?: '#171116' }};
        --footer-accent: {{ component.accent_color ?: '#E62973' }};
        --footer-card: {{ component.card_color ?: '#211A20' }};
        --footer-text: {{ component.text_color ?: '#FFFFFF' }};
        --footer-muted: {{ component.muted_color ?: '#B8AEB4' }};
        --footer-padding: {{ component.section_padding ?: 80 }}px;
    "
>

    {# =====================================================
       DECORATIVE BACKGROUND
    ===================================================== #}

    <div
        class="luxury-footer__background"
        aria-hidden="true"
    >

        <span class="luxury-footer__orb luxury-footer__orb--one"></span>

        <span class="luxury-footer__orb luxury-footer__orb--two"></span>

        <span class="luxury-footer__grid"></span>

    </div>


    {# =====================================================
       TOP ACCENT LINE
    ===================================================== #}

    <div
        class="luxury-footer__top-line"
        aria-hidden="true"
    ></div>


    <div class="container luxury-footer__container">


        {# =================================================
           INTRO
        ================================================= #}

        <div class="luxury-footer__intro">


            {% if component.show_eyebrow and component.eyebrow %}

                <div class="luxury-footer__eyebrow">

                    <span class="luxury-footer__eyebrow-line"></span>

                    <span>
                        {{ component.eyebrow }}
                    </span>

                    <span class="luxury-footer__eyebrow-line"></span>

                </div>

            {% endif %}


            {% if component.show_title and component.title %}

                <h2 class="luxury-footer__title">

                    {{ component.title }}

                </h2>

            {% endif %}


            {% if component.show_description and component.description %}

                <p class="luxury-footer__description">

                    {{ component.description }}

                </p>

            {% endif %}

        </div>


        {# =================================================
           MAIN FOOTER CONTENT
        ================================================= #}

        <div class="luxury-footer__main">


            {# =================================================
               BRAND / SOCIAL
            ================================================= #}

            <div class="luxury-footer__brand-column">


                <div class="luxury-footer__brand-mark">

                    <a href="{{ store.url ?: '/' }}" class="luxury-footer__logo-link" aria-label="الصفحة الرئيسية">
    <img
        src="{{ 'images/theme-logo.png' | asset }}"
        alt="شعار المتجر"
        class="luxury-footer__logo"
        loading="lazy"
        decoding="async"
    >
</a>


                </div>


                <p class="luxury-footer__brand-text">

                    تجربة تسوق أنيقة تجمع بين الجودة،
                    التفاصيل الراقية، والهوية العصرية.

                </p>


                {% if component.show_social %}

                    <div class="luxury-footer__social">

                        <a
                            href="#"
                            class="luxury-footer__social-item"
                            aria-label="Instagram"
                        >
                            <i class="sicon-instagram"></i>
                        </a>


                        <a
                            href="#"
                            class="luxury-footer__social-item"
                            aria-label="X"
                        >
                            <i class="sicon-twitter"></i>
                        </a>


                        <a
                            href="#"
                            class="luxury-footer__social-item"
                            aria-label="TikTok"
                        >
                            <i class="sicon-tiktok"></i>
                        </a>


                        <a
                            href="#"
                            class="luxury-footer__social-item"
                            aria-label="YouTube"
                        >
                            <i class="sicon-youtube"></i>
                        </a>

                    </div>

                {% endif %}

            </div>


            {# =================================================
               IMPORTANT LINKS
            ================================================= #}

            <div class="luxury-footer__column">

                <div class="luxury-footer__column-title">

                    روابط مهمة

                </div>


                <nav class="luxury-footer__links">


                    {% if component.show_legal %}

                        {% if component.terms_url %}

                            <a
                                href="{{ component.terms_url }}"
                                class="luxury-footer__link"
                            >
                                الشروط والأحكام
                            </a>

                        {% endif %}


                        {% if component.privacy_url %}

                            <a
                                href="{{ component.privacy_url }}"
                                class="luxury-footer__link"
                            >
                                سياسة الخصوصية
                            </a>

                        {% endif %}


                        {% if component.returns_url %}

                            <a
                                href="{{ component.returns_url }}"
                                class="luxury-footer__link"
                            >
                                الاستبدال والاسترجاع
                            </a>

                        {% endif %}

                    {% endif %}


                    <a
                        href="/"
                        class="luxury-footer__link"
                    >
                        الرئيسية
                    </a>


                </nav>

            </div>


            {# =================================================
               NEWSLETTER
            ================================================= #}

            {% if component.show_newsletter %}

                <div class="luxury-footer__column luxury-footer__newsletter">

                    <div class="luxury-footer__column-title">

                        النشرة البريدية

                    </div>


                    <p class="luxury-footer__column-description">

                        اشتركي ليصلك كل جديد من المنتجات
                        والعروض المميزة.

                    </p>


                    <div class="luxury-footer__newsletter-box">

                        <input
                            type="email"
                            class="luxury-footer__newsletter-input"
                            placeholder="بريدك الإلكتروني"
                            aria-label="البريد الإلكتروني"
                        >

                        <button
                            type="button"
                            class="luxury-footer__newsletter-button"
                            aria-label="اشتراك"
                        >

                            <i class="sicon-arrow-left"></i>

                        </button>

                    </div>

                </div>

            {% endif %}

{# =================================================
   PAYMENT METHODS
================================================= #}

<div class="luxury-footer__payments">

    <span class="luxury-footer__payments-title">
        طرق الدفع
    </span>

    <div class="luxury-footer__payment-list">

        <span class="luxury-footer__payment">
            <img
                src="{{ 'images/payment/visa.png'|asset }}"
                alt="Visa"
                loading="lazy"
            >
        </span>

        <span class="luxury-footer__payment">
            <img
                src="{{ 'images/payment/mastercard.png'|asset }}"
                alt="Mastercard"
                loading="lazy"
            >
        </span>

        <span class="luxury-footer__payment">
            <img
                src="{{ 'images/payment/mada.png'|asset }}"
                alt="Mada"
                loading="lazy"
            >
        </span>

        <span class="luxury-footer__payment">
            <img
                src="{{ 'images/payment/apple-pay.png'|asset }}"
                alt="Apple Pay"
                loading="lazy"
            >
        </span>

        <span class="luxury-footer__payment">
            <img
                src="{{ 'images/payment/stc-pay.png'|asset }}"
                alt="STC Pay"
                loading="lazy"
            >
        </span>

    </div>

</div>


        {# =================================================
           BOTTOM
        ================================================= #}

        <div class="luxury-footer__bottom">


            <div class="luxury-footer__copyright">

                © {{ "now"|date("Y") }}

                <span>
                    {{ component.copyright ?: 'جميع الحقوق محفوظة' }}
                </span>

            </div>


            {% if component.show_legal %}

                <div class="luxury-footer__legal">


                    {% if component.terms_url %}

                        <a href="{{ component.terms_url }}">
                            الشروط والأحكام
                        </a>

                    {% endif %}


                    {% if component.privacy_url %}

                        <a href="{{ component.privacy_url }}">
                            الخصوصية
                        </a>

                    {% endif %}


                    {% if component.returns_url %}

                        <a href="{{ component.returns_url }}">
                            الاستبدال والاسترجاع
                        </a>

                    {% endif %}

                </div>

            {% endif %}


            <div class="luxury-footer__signature">

                Crafted with

                <span aria-hidden="true">♥</span>

                by

                <strong>RAWAN</strong>

            </div>


        </div>

    </div>

</footer>




