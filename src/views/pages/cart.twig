{% extends "layouts.master" %}

{% block content %}

<div class="rawan-cart-page">

    {# =========================================================
       BREADCRUMBS
    ========================================================== #}

    <div class="container">
        <nav class="rawan-cart-breadcrumbs">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
    </div>

    <h1 class="sr-only">
        {{ trans('blocks.header.cart') }}
    </h1>

    {# =========================================================
       CONDITIONAL OFFERS
    ========================================================== #}

    <salla-conditional-offer
        data-testid="store-cart-conditional-offer">
    </salla-conditional-offer>


    <div class="container">

        {# =====================================================
           CART HEADER
        ====================================================== #}

        <header class="rawan-cart-header">

            <div class="rawan-cart-header__badge">
                <span></span>
                سلة التسوق
            </div>

            <h2>
                مشترياتك المختارة
            </h2>

            <p>
                راجع منتجاتك قبل إتمام الطلب واستمتع بتجربة تسوق أنيقة وسهلة.
            </p>

            <div class="rawan-cart-header__line">
                <i></i>
            </div>

        </header>


        {# =====================================================
           MAIN CART
        ====================================================== #}

        <div class="rawan-cart-layout">

            {# =================================================
               PRODUCTS
            ================================================== #}

            <div class="rawan-cart-products">

                {% hook 'cart:items.start' %}


                {% for item in cart.items %}

                    <form
                        id="item-{{ item.id }}"
                        class="rawan-cart-item-form"
                        onchange="salla.form.onChange('cart.updateItem', event)"
                    >

                        <input
                            type="hidden"
                            name="id"
                            value="{{ item.id }}"
                        >


                        <article
                            data-testid="store-cart-item-{{ item.id }}"
                            class="rawan-cart-item"
                        >

                            {# PRODUCT IMAGE #}

                            <div class="rawan-cart-item__image">

                                <a href="{{ item.url }}">

                                    <img
                                        src="{{ item.product_image }}"
                                        alt="{{ item.product_name }}"
                                        loading="{{ loop.first ? 'eager' : 'lazy' }}"
                                    >

                                </a>


                                {% if item.price.getMoney().amount == 0 and item.has_discount %}

                                    <span class="rawan-cart-free">
                                        {{ trans('pages.loyalty_program.free_product') }}
                                    </span>

                                {% endif %}

                            </div>


                            {# PRODUCT INFORMATION #}

                            <div class="rawan-cart-item__info">

                                <div class="rawan-cart-item__top">

                                    <div>

                                        <span class="rawan-cart-item__label">
                                            منتج
                                        </span>

                                        <h3>
                                            <a href="{{ item.url }}">
                                                {{ item.product_name }}
                                            </a>
                                        </h3>

                                    </div>


                                    {# DELETE #}

                                    <button
                                        type="button"
                                        class="rawan-cart-delete"
                                        aria-label="حذف المنتج"
                                        onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())"
                                    >
                                        <i class="sicon-trash"></i>
                                    </button>

                                </div>


                                {# PRICE #}

                                <div class="rawan-cart-prices">

                                    {% if item.offer %}

                                        <span class="rawan-cart-old-price">
                                            {{ item.product_price|money }}
                                        </span>

                                    {% endif %}


                                    {% if item.is_on_sale %}

                                        <span class="rawan-cart-old-price">
                                            {{ item.original_price|money }}
                                        </span>

                                    {% endif %}


                                    <strong
                                        data-testid="store-cart-item-price"
                                        class="rawan-cart-price {{ item.has_discount ? 'is-discounted' : '' }}"
                                    >
                                        {{ item.price|money }}
                                    </strong>

                                </div>


                                {# OFFER #}

                                <div class="rawan-cart-offer {{ item.offer ? '' : 'hidden' }}">

                                    <i class="sicon-discount-calculator"></i>

                                    <span>
                                        {{ item.offer.names }}
                                    </span>

                                </div>


                                <salla-cart-item-offers
                                    quantity="{{ item.quantity }}"
                                    item-id="{{ item.id }}"
                                    product-price="{{ item.product_price }}"
                                    offers="{{ item.detailed_offers|json_encode }}">
                                </salla-cart-item-offers>


                                {# BOTTOM #}

                                <div class="rawan-cart-item__bottom">


                                    {# QUANTITY #}

                                    <div class="rawan-cart-quantity">

                                        <span>
                                            الكمية
                                        </span>


                                        {% if item.type == 'donating' %}

                                            <span class="rawan-cart-quantity-static">
                                                {{ item.quantity }}
                                            </span>

                                        {% elseif item.is_hidden_quantity %}

                                            <input
                                                type="hidden"
                                                value="{{ item.quantity }}"
                                                name="quantity"
                                            >

                                            <span class="rawan-cart-quantity-static">
                                                {{ item.quantity }}
                                            </span>

                                        {% else %}

                                            <salla-quantity-input
                                                cart-item-id="{{ item.id }}"
                                                max="{{ item.max_quantity }}"
                                                value="{{ item.quantity }}"
                                                name="quantity"
                                                aria-label="Quantity">
                                            </salla-quantity-input>

                                        {% endif %}

                                    </div>


                                    {# TOTAL #}

                                    {% set item_total =
                                        item.detailed_offers|length > 0
                                        ? item.total_special_price|money
                                        : item.total|money
                                    %}


                                    <div class="rawan-cart-item-total">

                                        <span>
                                            الإجمالي
                                        </span>

                                        <strong data-testid="store-cart-item-total">

                                            {{ item.is_available
                                                ? item_total
                                                : trans('pages.cart.out_of_stock')
                                            }}

                                        </strong>

                                    </div>

                                </div>


                                {# OPTIONS #}

                                {% include 'pages.partials.product.options' with {product:item} %}

                            </div>

                        </article>

                    </form>

                {% else %}

                    {# =================================================
                       EMPTY CART
                    ================================================== #}

                    <div
                        data-testid="store-cart-empty"
                        class="rawan-empty-cart"
                    >

                        <div class="rawan-empty-cart__icon">
                            <i class="sicon-shopping-bag"></i>
                        </div>

                        <span>
                            سلة التسوق
                        </span>

                        <h2>
                            سلتك فارغة
                        </h2>

                        <p>
                            لم تضف أي منتجات إلى سلة التسوق بعد.
                        </p>

                        <a
                            data-testid="store-cart-back-home"
                            href="{{ link('/') }}"
                            class="rawan-cart-home-btn"
                        >
                            متابعة التسوق
                        </a>

                    </div>

                {% endfor %}


                {# CART OPTIONS #}

                {% if cart.options|length %}

                    <div class="rawan-cart-options">

                        {% for product_option in cart.options %}

                            <form
                                onchange="salla.form.onChange('cart.updateItem', event)"
                                id="item-{{ product_option.id }}"
                            >

                                <input
                                    type="hidden"
                                    name="id"
                                    value="{{ product_option.id }}"
                                >

                                <input
                                    type="hidden"
                                    name="quantity"
                                    value="{{ product_option.quantity }}"
                                >

                                {% include 'pages.partials.product.options' with {
                                    product: product_option
                                } %}

                            </form>

                        {% endfor %}

                    </div>

                {% endif %}


                <salla-offer
                    data-testid="store-cart-offer">
                </salla-offer>


                {% hook 'cart:items.end' %}

            </div>


            {# =================================================
               CART SUMMARY
            ================================================== #}

            {% hook 'cart:summary.start' %}


            {% if cart.items|length %}

                <aside class="rawan-cart-sidebar">


                    {# FREE SHIPPING #}

                    {% if cart.free_shipping_bar %}

                        {% set is_free = cart.free_shipping_bar.has_free_shipping %}

                        <div
                            id="free-shipping"
                            class="rawan-shipping-card"
                        >

                            <div class="rawan-shipping-card__top">

                                <div class="rawan-shipping-icon">
                                    <i class="sicon-shipping-fast"></i>
                                </div>

                                <div>

                                    <strong>
                                        شحن مجاني
                                    </strong>

                                    <p>

                                        <span id="free-shipping-msg">

                                            {{
                                                (
                                                    is_free
                                                    ? trans('pages.cart.has_free_shipping')
                                                    : trans(
                                                        'pages.cart.free_shipping_alert',
                                                        {
                                                            'amount':
                                                            cart.free_shipping_bar.remaining|money
                                                        }
                                                    )
                                                )|raw
                                            }}

                                        </span>

                                        <span
                                            id="free-shipping-applied"
                                            class="{{ is_free ? '' : 'hidden' }}"
                                        >
                                            🎉
                                        </span>

                                    </p>

                                </div>

                            </div>


                            <div
                                id="free-shipping-bar"
                                class="rawan-shipping-progress {{ is_free ? 'hidden' : '' }}"
                            >

                                <div
                                    class="rawan-shipping-progress__bar"
                                    style="width:{{ cart.free_shipping_bar.percent }}%"
                                >
                                </div>

                            </div>

                        </div>

                    {% endif %}


                    {# LOYALTY #}

                    {% if loyalty %}

                        <div class="rawan-sidebar-widget">

                            <salla-loyalty-panel
                                data-testid="store-cart-loyalty"
                                prize-points="{{ loyalty.prize.points }}"
                                prize-title="{{ loyalty.prize.title }}">
                            </salla-loyalty-panel>

                        </div>

                    {% endif %}


                    {# GIFTING #}

                    <div
                        id="cart-gifting"
                        class="rawan-sidebar-widget {{ gift.enabled ? '' : 'hidden' }}"
                    >

                        <salla-gifting
                            data-testid="store-cart-gifting"
                            id="salla-gifting"
                            widget-title="{{ trans('pages.cart.gift_widget_title') }}"
                            widget-subtitle="{{ gift.text }}"
                            {{ gift.type }}-products
                            vertical>
                        </salla-gifting>

                    </div>


                    {# COUPON #}

                    {% if store.settings.cart.apply_coupon_enabled %}

                        <div class="rawan-coupon-card">

                            {% hook 'cart:coupon.start' %}

                            <div class="rawan-sidebar-title">
                                <i class="sicon-discount"></i>
                                <span>كود الخصم</span>
                            </div>

                            <salla-cart-coupons
                                data-testid="store-cart-coupons">
                            </salla-cart-coupons>

                            {% hook 'cart:coupon.end' %}

                        </div>

                    {% endif %}


                    {# SUMMARY #}

                    {% hook 'cart:summary-card.start' %}

                    <div class="rawan-summary-card">

                        <div class="rawan-summary-card__heading">

                            <span>
                                ملخص الطلب
                            </span>

                            <i class="sicon-shopping-bag"></i>

                        </div>

                        <salla-cart-summary-card
                            data-testid="store-cart-summary">
                        </salla-cart-summary-card>

                    </div>

                    {% hook 'cart:summary-card.end' %}


                    {# TIERED OFFER #}

                    <div class="rawan-tiered-offer">

                        <salla-tiered-offer
                            data-testid="store-cart-tiered-offer">
                        </salla-tiered-offer>

                    </div>


                    {% hook 'cart:summary.end' %}

                </aside>

            {% endif %}

        </div>

    </div>

</div>

{% endblock %}


{% block scripts %}

    <script
        defer
        src="{{ 'checkout.js' | asset }}">
    </script>

{% endblock %}