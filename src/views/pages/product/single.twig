{% extends "layouts.master" %}

{% block content %}

{# =========================================================
PRODUCT DETAILS — SALLA DEFAULT STRUCTURE
مع الحفاظ على جميع تفاصيل صفحة المنتج الافتراضية
========================================================= #}

{# Breadcrumbs #}
{% if theme.settings.get('product_show_breadcrumbs', true) %}
<div class="container container--breadcrumbs">
<nav class="breadcrumbs w-full">
<salla-breadcrumb></salla-breadcrumb>
</nav>
</div>
{% endif %}

{# Before Product Info Hooks #}

<div class="s-blocks-wrapper s-before-product-info !mt-0"> {% hook 'product.single.before_product_info' %} </div>
{# =========================================================
PRODUCT
========================================================= #}

<main class="product-single" data-product-id="{{ product.id }}" >
<div class="container">

    <div class="product-single__content">

        {# =================================================
           PRODUCT MEDIA / IMAGES
        ================================================== #}

        <div class="product-single__media">

            {% set has_many_images = product.images|length > 1 %}

            <div class="product-single__media-wrapper">

                <salla-slider
                    data-testid="store-product-image-slider"
                    id="details-slider-{{ product.id }}"
                    class="details-slider image-slider"
                    type="thumbs"
                    loop="false"
                    auto-height
                    listen-to-thumbnails-option
                    show-thumbs-controls="false"
                >

                    {# Promotion #}
                    {% if product.promotion_title %}
                        <div class="s-product-card-promotion-title">
                            {{ product.promotion_title }}
                        </div>
                    {% endif %}

                    {# Wishlist #}
                    <salla-button
                        class="btn--wishlist"
                        data-id="{{ product.id }}"
                        onclick="salla.wishlist.toggle('{{ product.id }}')"
                        shape="icon"
                        fill="outline"
                        color="light"
                        aria-label="إضافة إلى المفضلة"
                    >
                        <i class="sicon-heart"></i>
                    </salla-button>

                    {# Calories #}
                    {% if product.calories %}
                        <div class="product-calories">
                            <strong>{{ product.calories }}</strong>
                            <span>{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    {# Main Images #}
                    <div slot="items">

                        {% for image in product.images %}

                            {% if image.three_d_image_url %}

                                <model-viewer
                                    style="min-height:500px"
                                    class="swiper-slide model-entry"
                                    loading="eager"
                                    camera-controls
                                    touch-action="pan-y"
                                    auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1"
                                    alt="{{ image.alt }}"
                                ></model-viewer>

                            {% else %}

                                <a
                                    data-fslightbox="product_{{ product.id }}"
                                    data-img-id="{{ image.id }}"
                                    data-slid-index="{{ loop.index - 1 }}"
                                    {% if image.video_url %}
                                        data-video-src="{{ image.video_url }}"
                                    {% endif %}
                                    data-caption="{{ image.alt }}"
                                    data-infinite="false"
                                    data-type="{{ image.video_type ?? 'image' }}"
                                    href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                    aria-label="{{ product.name }}"
                                    class="swiper-slide magnify-wrapper {{ image.video_url ? 'video-entry' : '' }}"
                                >

                                    <img
                                        id="{{ image.id }}"
                                        src="{{ image.url }}"
                                        alt="{{ image.alt }}"
                                        loading="{{ loop.first ? 'eager' : 'lazy' }}"
                                        {% if loop.first %}
                                            fetchpriority="high"
                                        {% endif %}
                                    >

                                </a>

                            {% endif %}

                        {% endfor %}

                    </div>

                    {# Thumbnails #}
                    {% if has_many_images %}

                        <div
                            data-testid="store-product-thumbnails"
                            slot="thumbs"
                            class="s-product-thumbnails"
                        >

                            {% for image in product.images %}

                                <div
                                    class="slide--one-fourth {{ image.video_url ? 'video-entry' : '' }} {{ image.three_d_image_url ? 'model-entry' : '' }}"
                                    data-caption="{{ image.alt }}"
                                >

                                    <img
                                        src="{{ image.url }}"
                                        loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}"
                                        title="{{ image.alt }}"
                                        alt="{{ image.alt }}"
                                    >

                                </div>

                            {% endfor %}

                        </div>

                    {% endif %}

                </salla-slider>

            </div>

        </div>

        {# =================================================
           PRODUCT INFO
        ================================================== #}

        <div class="product-single__info">

            {% hook 'product:single.description.start' %}

            {# Brand #}
            {% if product.brand and product.brand.name %}

                <div class="product-brand">

                    <a
                        href="{{ product.brand.url }}"
                        title="{{ product.brand.name }}"
                    >

                        {% if product.brand.logo %}

                            <img
                                src="{{ product.brand.logo }}"
                                alt="{{ product.brand.name }}"
                                title="{{ product.brand.name }}"
                            >

                        {% else %}

                            {{ product.brand.name }}

                        {% endif %}

                    </a>

                </div>

            {% endif %}

            {# Product Title #}
            <h1
                data-testid="store-product-title"
                class="product-title"
            >
                {{ product.name }}
            </h1>

            {# Subtitle #}
            {% if product.subtitle %}

                <div class="product-subtitle">
                    {{ product.subtitle }}
                </div>

            {% endif %}

            {# Rating #}
            {% if product.rating %}

                <div class="product-rating">

                    <salla-rating-stars
                        data-testid="store-product-rating"
                        value="{{ product.rating.stars }}"
                        reviews="{{ product.rating.count }}"
                    ></salla-rating-stars>

                </div>

            {% endif %}

            {# Tax #}
            {% if product.is_taxable %}

                <div class="product-tax">
                    {{ trans('pages.products.tax_included') }}
                </div>

            {% endif %}

            {# Price #}
            <div
                data-testid="store-product-price"
                class="product__price"
            >

                {% if product.is_on_sale %}

                    <div class="sale-price">

                        <strong>
                            {{ product.sale_price|money }}
                        </strong>

                        <del>
                            {{ product.regular_price|money }}
                        </del>

                        {% if product.discount_percentage %}

                            <span>
                                {{ product.discount_percentage }}
                            </span>

                        {% endif %}

                    </div>

                {% else %}

                    <div class="normal-price">

                        {% if product.starting_price %}

                            <span>
                                {{ trans('pages.products.starting_price') }}
                            </span>

                        {% endif %}

                        <strong>
                            {{ product.starting_price
                                ? product.starting_price|money
                                : product.price|money
                            }}
                        </strong>

                    </div>

                {% endif %}

            </div>

            {# Description #}
            <div
                data-testid="store-product-description"
                class="product__description"
            >

                {% set product_desc = product.description|replace({"&nbsp;":"\n"}) %}

                {% if product.has_read_more %}

                    <article
                        class="article article--main"
                        id="more-content"
                        style="max-height:5.25rem"
                    >
                        {{ product_desc|raw }}
                    </article>

                    <a
                        id="btn-show-more"
                        class="product__read-more"
                    >
                        {{ trans('pages.products.read_more') }}
                    </a>

                {% else %}

                    <article class="article--main">
                        {{ product_desc|raw }}
                    </article>

                {% endif %}

            </div>

            {# Tags #}
            {% if product.tags|length and theme.settings.get('show_tags', true) %}

                <div class="product__tags">

                    {% for tag in product.tags %}

                        <a href="{{ tag.url }}">
                            {{ tag.name }}
                        </a>

                    {% endfor %}

                </div>

            {% endif %}

            {# Share + Wishlist #}
            <div class="product__actions">

                <salla-social-share
                    data-testid="store-product-social-share"
                    aria-label="مشاركة المنتج"
                ></salla-social-share>

                <salla-button
                    data-testid="store-product-wishlist-btn"
                    class="btn--wishlist hidden sm:inline-flex"
                    data-id="{{ product.id }}"
                    onclick="salla.wishlist.toggle('{{ product.id }}')"
                    shape="icon"
                    fill="outline"
                    color="light"
                    aria-label="إضافة إلى المفضلة"
                >
                    <i class="sicon-heart"></i>
                </salla-button>

            </div>

            {# Stock #}
            {% if product.sold_quantity or product.can_show_remained_quantity %}

                <div class="product__stock">

                    {% if product.sold_quantity %}

                        <div>

                            <i class="sicon-fire"></i>

                            {{ trans('pages.products.sold') }}

                            <span>
                                {{ pluralize(
                                    'pages.products.sold_times',
                                    product.sold_quantity
                                )|raw }}
                            </span>

                        </div>

                    {% endif %}

                    {% if product.can_show_remained_quantity %}

                        <div>

                            <i class="sicon-box-bankers"></i>

                            {{ trans('pages.products.remained') }}

                            <span>
                                {{ product.quantity }}
                            </span>

                        </div>

                    {% endif %}

                </div>

            {% endif %}

            {# SKU #}
            {% if product.sku %}

                <div class="product__sku">

                    <div>

                        <i class="sicon-barcode"></i>

                        {{ trans('pages.products.sku') }}

                    </div>

                    <strong class="product-sku">
                        {{ product.sku }}
                    </strong>

                </div>

            {% endif %}

            {% hook 'product:single.description' %}

            {# Installments #}
            <salla-installment
                data-testid="store-product-installment"
                price="{{ product.price }}"
            ></salla-installment>

            {# Metadata #}
            {% if product.has_metadata %}

                <salla-metadata
                    data-testid="store-product-metadata"
                ></salla-metadata>

            {% endif %}

            {# Availability #}
            {% if product.show_availability %}

                <section class="product__availability">

                    <div>

                        <span>

                            <i class="sicon-location"></i>

                            {{ trans('pages.products.availability') }}

                        </span>

                        <a
                            href="#!"
                            onclick="salla.event.dispatch('scopes::open', {
                                mode: 'availability',
                                product_id: '{{ product.id }}'
                            })"
                        >
                            {{ trans('pages.products.select_branch') }}
                        </a>

                    </div>

                </section>

            {% endif %}

            {# Digital Files #}
            {% if product.digital_files_settings %}

                <digital-files-settings
                    settings="{{ product.digital_files_settings|json_encode }}"
                ></digital-files-settings>

            {% endif %}

            {# =================================================
               PRODUCT FORM
            ================================================== #}

            <form
                data-testid="store-product-form"
                class="form product-form"
                id="product-form"
                enctype="multipart/form-data"
                method="post"
                onsubmit="return salla.form.onSubmit('cart.addItem', event)"
            >

                <input
                    type="hidden"
                    name="id"
                    value="{{ product.id }}"
                >

                {% hook 'product:single.form.start' %}

                {# Product Options #}
                {% include 'pages.partials.product.options' %}

                {% hook 'product:single.form.end' %}

                {# Price #}
                <section class="product-form__price">

                    <span>
                        {{ trans('pages.products.price') }}
                    </span>

                    <div class="price-wrapper">

                        {% if product.is_on_sale %}

                            <strong class="total-price">
                                {{ product.sale_price|money }}
                            </strong>

                            <del class="before-price">
                                {{ product.regular_price|money }}
                            </del>

                        {% else %}

                            {% if product.starting_price %}

                                <span class="starting-price-title">
                                    {{ trans('pages.products.starting_price') }}
                                </span>

                            {% endif %}

                            <strong class="total-price">
                                {{
                                    product.starting_price
                                    ? product.starting_price|money
                                    : product.price|money
                                }}
                            </strong>

                        {% endif %}

                    </div>

                    <div
                        data-testid="store-product-out-of-stock"
                        class="out-of-stock hidden"
                    >
                        {{ trans('pages.products.out_of_stock') }}
                    </div>

                </section>

                {# =================================================
                   DEFAULT SALLA ADD TO CART
                ================================================== #}

                <div class="product-form__cart">

                    {% hook 'product:single.form.cart.start' %}

                    <div class="product-form__quantity">

                        <label class="form-label">
                            {{ trans('pages.products.quantity') }}
                        </label>

                        <salla-quantity-input
                            max="{{ product.max_quantity }}"
                            value="1"
                            name="quantity"
                        ></salla-quantity-input>

                    </div>

                    <salla-add-product-button
                        fill="solid"
                        width="wide"
                        product-id="{{ product.id }}"
                        type="submit"
                    ></salla-add-product-button>

                    {% hook 'product:single.form.cart.end' %}

                </div>

            </form>

        </div>

    </div>

</div>

</main>
{# =========================================================
BEFORE RELATED PRODUCTS
========================================================= #}

<div class="s-blocks-wrapper"> {% hook 'product.single.after_product_info' %} </div>
{# =========================================================
RELATED PRODUCTS — SAME CATEGORY
========================================================= #}

{% if product.category %}

<section class="rawan-related-products">
<div class="container">

    <div class="rawan-related-heading">

        <span>RAWAN COLLECTION</span>

        <h2>
            منتجات قد تعجبك
        </h2>

        <p>
            اكتشفي المزيد من المنتجات من نفس الفئة
        </p>

    </div>

    <salla-products-slider
        source="categories"
        source-value="{{ product.category.id }}"
        block-title=""
    ></salla-products-slider>

</div>

</section>
{% endif %}

{# =========================================================
TESTIMONIALS
========================================================= #}

{% if store.settings.category.testimonial_enabled %}

{% component 'home.testimonials' %}

{% endif %}

<div class="s-blocks-wrapper"> {% hook 'product.index.after_testimonials' %} </div>
{% endblock %}

{% block scripts %}

<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}