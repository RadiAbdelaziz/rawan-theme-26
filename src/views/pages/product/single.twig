{% extends "layouts.master" %}

{% block content %}

    {# =========================================================
       RAWAN — PRODUCT PAGE
    ========================================================== #}

    {% if theme.settings.get('product_show_breadcrumbs', true) %}
        <div class="container container--breadcrumbs rawan-breadcrumbs">
            <nav class="breadcrumbs w-full">
                <salla-breadcrumb></salla-breadcrumb>
            </nav>
        </div>
    {% endif %}


    {# =========================================================
       BEFORE PRODUCT INFO
    ========================================================== #}

    <div class="s-blocks-wrapper s-before-product-info !mt-0">
        {% hook 'product.single.before_product_info' %}
    </div>


    <main class="rawan-product-page">


        {# =====================================================
           RAWAN PRODUCT HEADER
        ====================================================== #}

        <section class="rawan-section-heading">

            <div class="rawan-heading-line"></div>

            <div class="rawan-heading-content">

                <span class="rawan-heading-kicker">
                    {{ product.category.name|default('منتجاتنا') }}
                </span>

                <h2>
                    {{ product.name }}
                </h2>

                <span class="rawan-heading-dot"></span>

            </div>

            <div class="rawan-heading-line"></div>

        </section>


        {# =====================================================
           PRODUCT DETAILS
        ====================================================== #}

        <div class="container container--product-details">

            <div
                class="rawan-product-grid"
                id="product-{{ product.id }}"
            >


                {# =================================================
                   PRODUCT MEDIA
                ================================================== #}

                <div class="rawan-product-media">

                    {% set has_many_images = product.images|length > 1 %}

                    <div class="rawan-media-card">

                        <salla-slider
                            data-testid="store-product-image-slider"
                            id="details-slider-{{ product.id }}"
                            class="details-slider image-slider rawan-slider"
                            type="thumbs"
                            loop="false"
                            auto-height
                            listen-to-thumbnails-option
                            show-thumbs-controls="false"
                        >

                            {% if product.promotion_title %}

                                <div class="rawan-promotion">
                                    {{ product.promotion_title }}
                                </div>

                            {% endif %}


                            {# Wishlist #}

                            <salla-button
                                class="btn--wishlist rawan-image-wishlist"
                                data-id="{{ product.id }}"
                                onclick="salla.wishlist.toggle('{{ product.id }}')"
                                shape="icon"
                                fill="outline"
                                color="light"
                                aria-label="add to wishlist"
                            >
                                <i class="sicon-heart"></i>
                            </salla-button>


                            {# Calories #}

                            {% if product.calories %}

                                <div class="rawan-calories">

                                    <strong>
                                        {{ product.calories }}
                                    </strong>

                                    <span>
                                        {{ trans('pages.products.calories') }}
                                    </span>

                                </div>

                            {% endif %}


                            {# Product Images #}

                            <div slot="items">

                                {% for image in product.images %}

                                    {% if image.three_d_image_url %}

                                        <model-viewer
                                            style="min-height:500px"
                                            class="swiper-slide model-entry rawan-model"
                                            loading="eager"
                                            camera-controls
                                            touch-action="pan-y"
                                            auto-rotate
                                            poster="{{ image.url }}"
                                            src="{{ image.three_d_image_url }}"
                                            shadow-intensity="1"
                                            alt="{{ image.alt }}"
                                        ></model-viewer>

                                    {% else %}

                                        <a
                                            data-fslightbox="product_{{ product.id }}"
                                            data-img-id="{{ image.id }}"
                                            data-slid-index="{{ loop.index - 1 }}"

                                            {% if image.video_url %}
                                                data-video-src="{{ image.video_url }}"
                                            {% endif %}

                                            data-caption="{{ image.alt }}"
                                            data-infinite="false"
                                            data-type="{{ image.video_type ?? 'image' }}"

                                            href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"

                                            aria-label="{{ product.name }}"

                                            class="swiper-slide magnify-wrapper rawan-product-image {{ image.video_url ? 'video-entry' : '' }}"
                                        >

                                            <img
                                                id="{{ image.id }}"
                                                src="{{ image.url }}"
                                                alt="{{ image.alt }}"
                                                loading="{{ loop.first ? 'eager' : 'lazy' }}"

                                                {% if loop.first %}
                                                    fetchpriority="high"
                                                {% endif %}
                                            >

                                        </a>

                                    {% endif %}

                                {% endfor %}

                            </div>


                            {# Thumbnails #}

                            {% if has_many_images %}

                                <div
                                    data-testid="store-product-thumbnails"
                                    slot="thumbs"
                                    class="rawan-thumbnails"
                                >

                                    {% for image in product.images %}

                                        <div
                                            class="
                                                slide--one-fourth
                                                rawan-thumbnail
                                                {{ image.video_url ? 'video-entry' : '' }}
                                                {{ image.three_d_image_url ? 'model-entry' : '' }}
                                            "
                                            data-caption="{{ image.alt }}"
                                        >

                                            <img
                                                src="{{ image.url }}"
                                                loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}"
                                                title="{{ image.alt }}"
                                                alt="{{ image.alt }}"
                                            >

                                        </div>

                                    {% endfor %}

                                </div>

                            {% endif %}

                        </salla-slider>

                    </div>

                </div>


                {# =================================================
                   PRODUCT INFORMATION
                ================================================== #}

                <div class="rawan-product-info">

                    {% hook 'product:single.description.start' %}


                    {# BRAND #}

                    {% if product.brand.name %}

                        <div class="rawan-brand">

                            <a
                                href="{{ product.brand.url }}"
                                title="{{ product.brand.name }}"
                                class="rawan-brand-logo"
                            >

                                <img
                                    src="{{ product.brand.logo }}"
                                    alt="{{ product.brand.name }}"
                                    title="{{ product.brand.name }}"
                                >

                            </a>

                        </div>

                    {% endif %}


                    {# PRODUCT TITLE #}

                    <h1
                        data-testid="store-product-title"
                        class="rawan-product-title"
                    >
                        {{ product.name }}
                    </h1>


                    {# SUBTITLE #}

                    {% if product.subtitle %}

                        <div class="rawan-product-subtitle">
                            {{ product.subtitle }}
                        </div>

                    {% endif %}


                    {# RATING #}

                    {% if product.rating %}

                        <div class="rawan-rating">

                            <salla-rating-stars
                                data-testid="store-product-rating"
                                value="{{ product.rating.stars }}"
                                reviews="{{ product.rating.count }}"
                            ></salla-rating-stars>

                        </div>

                    {% endif %}


                    {# TAX #}

                    {% if product.is_taxable %}

                        <div class="rawan-tax">
                            {{ trans('pages.products.tax_included') }}
                        </div>

                    {% endif %}


                    {# PRICE #}

                    <div
                        data-testid="store-product-price"
                        class="rawan-price-box"
                    >

                        {% if product.is_on_sale %}

                            <div class="rawan-sale-price">

                                <strong>
                                    {{ product.sale_price|money }}
                                </strong>

                                <del>
                                    {{ product.regular_price|money }}
                                </del>

                                {% if product.discount_percentage %}

                                    <span class="rawan-discount">
                                        {{ product.discount_percentage }}
                                    </span>

                                {% endif %}

                            </div>

                        {% else %}

                            <div class="rawan-normal-price">

                                {% if product.starting_price %}

                                    <span>
                                        {{ trans('pages.products.starting_price') }}
                                    </span>

                                {% endif %}

                                <strong>
                                    {{
                                        product.starting_price
                                        ? product.starting_price|money
                                        : product.price|money
                                    }}
                                </strong>

                            </div>

                        {% endif %}

                    </div>


                    {# DESCRIPTION #}

                    <div
                        data-testid="store-product-description"
                        class="product__description rawan-description"
                    >

                        {% set product_desc = product.description|replace({"&nbsp;":"\n"}) %}

                        {% if product.has_read_more %}

                            <article
                                class="article article--main rawan-description-content"
                                id="more-content"
                                style="max-height:5.25rem"
                            >
                                {{ product_desc|raw }}
                            </article>

                            <a
                                id="btn-show-more"
                                class="rawan-read-more"
                            >
                                {{ trans('pages.products.read_more') }}
                            </a>

                        {% else %}

                            <article class="article--main rawan-description-content">
                                {{ product_desc|raw }}
                            </article>

                        {% endif %}

                    </div>


                    {# TAGS #}

                    {% if product.tags|length and theme.settings.get('show_tags', true) %}

                        <div class="rawan-tags">

                            {% for tag in product.tags %}

                                <a href="{{ tag.url }}">
                                    {{ tag.name }}
                                </a>

                            {% endfor %}

                        </div>

                    {% endif %}


                    {# SHARE + WISHLIST #}

                    <div class="rawan-actions">

                        <salla-social-share
                            data-testid="store-product-social-share"
                            aria-label="social share"
                        ></salla-social-share>

                        <salla-button
                            data-testid="store-product-wishlist-btn"
                            class="btn--wishlist rawan-content-wishlist hidden sm:inline-flex"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            shape="icon"
                            fill="outline"
                            color="light"
                            aria-label="add to wishlist"
                        >
                            <i class="sicon-heart"></i>
                        </salla-button>

                    </div>


                    {# SOLD / REMAINING #}

                    {% if product.sold_quantity or product.can_show_remained_quantity %}

                        <div class="rawan-stock-info">

                            {% if product.sold_quantity %}

                                <div>

                                    <i class="sicon-fire"></i>

                                    {{ trans('pages.products.sold') }}

                                    <span>
                                        {{
                                            pluralize(
                                                'pages.products.sold_times',
                                                product.sold_quantity
                                            )|raw
                                        }}
                                    </span>

                                </div>

                            {% endif %}


                            {% if product.can_show_remained_quantity %}

                                <div>

                                    <i class="sicon-box-bankers"></i>

                                    {{ trans('pages.products.remained') }}

                                    <span>
                                        {{ product.quantity }}
                                    </span>

                                </div>

                            {% endif %}

                        </div>

                    {% endif %}


                    {# SKU #}

                    {% if product.sku %}

                        <div class="rawan-sku">

                            <div>

                                <i class="sicon-barcode"></i>

                                {{ trans('pages.products.sku') }}

                            </div>

                            <strong class="product-sku">
                                {{ product.sku }}
                            </strong>

                        </div>

                    {% endif %}


                    {% hook 'product:single.description' %}


                    {# INSTALLMENTS #}

                    <salla-installment
                        data-testid="store-product-installment"
                        price="{{ product.price }}"
                    ></salla-installment>


                    {% if product.has_metadata %}

                        <salla-metadata
                            data-testid="store-product-metadata"
                        ></salla-metadata>

                    {% endif %}


                    {# AVAILABILITY #}

                    {% if product.show_availability %}

                        <section class="rawan-availability">

                            <div>

                                <span>
                                    <i class="sicon-location"></i>
                                    {{ trans('pages.products.availability') }}
                                </span>

                                <a
                                    href="#!"
                                    onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                >
                                    {{ trans('pages.products.select_branch') }}
                                </a>

                            </div>

                        </section>

                    {% endif %}


                    {# DIGITAL FILES #}

                    {% if product.digital_files_settings %}

                        <digital-files-settings
                            settings="{{ product.digital_files_settings|json_encode }}"
                        ></digital-files-settings>

                    {% endif %}


                    {# =================================================
                       PRODUCT FORM
                    ================================================== #}

                    <form
                        data-testid="store-product-form"
                        class="form product-form rawan-product-form"
                        enctype="multipart/form-data"
                        method="post"
                        onsubmit="return salla.form.onSubmit('cart.addItem', event)"
                    >

                        <input
                            type="hidden"
                            name="id"
                            value="{{ product.id }}"
                        >


                        {% hook 'product:single.form.start' %}


                        {% include 'pages.partials.product.options' %}


                        {% hook 'product:single.form.end' %}


                        {# TOTAL PRICE #}

                        <section class="rawan-cart-price">

                            <span>
                                {{ trans('pages.products.price') }}
                            </span>

                            <div class="price-wrapper">

                                {% if product.is_on_sale %}

                                    <strong class="total-price">
                                        {{ product.sale_price|money }}
                                    </strong>

                                    <del class="before-price">
                                        {{ product.regular_price|money }}
                                    </del>

                                {% else %}

                                    {% if product.starting_price %}

                                        <span class="starting-price-title">
                                            {{ trans('pages.products.starting_price') }}
                                        </span>

                                    {% endif %}

                                    <strong class="total-price">
                                        {{
                                            product.starting_price
                                            ? product.starting_price|money
                                            : product.price|money
                                        }}
                                    </strong>

                                {% endif %}

                            </div>


                            <div
                                data-testid="store-product-out-of-stock"
                                class="out-of-stock hidden"
                            >
                                {{ trans('pages.products.out_of_stock') }}
                            </div>

                        </section>


                        {# PREORDER #}

                        {% if product.has_preorder_campaign %}

                            <section class="rawan-preorder">

                                <salla-count-down
                                    data-testid="store-product-preorder-countdown"
                                    pre-order="{{ product.preorder|json_encode }}"
                                    boxed
                                    labeled
                                ></salla-count-down>

                            </section>

                        {% endif %}


                        {# QUANTITY + ADD TO CART #}

                        <section class="sticky-product-bar rawan-cart-box">

                            {% if product.is_hidden_quantity or product.type == 'booking' %}

                                <input
                                    type="hidden"
                                    value="1"
                                    name="quantity"
                                    aria-label="Quantity"
                                >

                            {% else %}

                                <div class="sticky-product-bar__quantity rawan-quantity">

                                    <label class="form-label">
                                        {{ trans('pages.products.quantity') }}
                                    </label>

                                    <salla-quantity-input
                                        data-testid="store-product-quantity"
                                        max="{{ product.max_quantity }}"
                                        value="1"
                                        name="quantity"
                                        aria-label="Quantity"
                                    ></salla-quantity-input>

                                </div>

                            {% endif %}


                            {# ADD TO CART #}

                            <salla-add-product-button
                                data-testid="store-product-add-to-cart"
                                {{ product.can_quick_buy ? 'quick-buy' : '' }}
                                {{ theme.settings.get('sticky_add_to_cart') ? 'support-sticky-bar' : '' }}
                                {{ product.is_require_shipping ? 'required-shipping' : '' }}
                                {{ product.has_preorder_campaign ? 'has-pre-order' : '' }}
                                amount="{{ product.base_currency_price }}"
                                class="sticky-product-bar__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"

                                {% if product.notify_availability %}

                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}

                                    channels="{{ product.notify_availability.channels|join(',') }}"

                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"

                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}

                                {% endif %}
                            >

                                {{ product.add_to_cart_label }}

                            </salla-add-product-button>

                        </section>

                    </form>


                    {# GIFTING #}

                    {% if product.is_giftable %}

                        <salla-gifting
                            data-testid="store-product-gifting"
                            class="rawan-gifting"
                            widget-subtitle="{{ gifting_intro }}"
                            product-id="{{ product.id }}"
                            {{ product.is_require_shipping ? 'physical-products' : '' }}
                        ></salla-gifting>

                    {% endif %}


                    {% hook 'product:single.description.end' %}


                    {# QUICK ORDER #}

                    <salla-quick-order
                        data-testid="store-product-quick-order"
                        class="rawan-quick-order"
                    ></salla-quick-order>

                </div>

            </div>


            <salla-offer
                data-testid="store-product-offer"
            ></salla-offer>

        </div>


        {# =========================================================
           REVIEWS
        ========================================================== #}

        <div class="s-blocks-wrapper s-before-reviews">
            {% hook 'product.single.before_customer_reviews' %}
        </div>


        {% if store.settings.rating.show_on_product %}

            <section class="rawan-reviews">

                <salla-comments
                    data-testid="store-product-comments"
                    item-id="{{ product.id }}"
                    type="product"
                ></salla-comments>

            </section>

        {% endif %}


        {# =========================================================
           RELATED PRODUCTS
        ========================================================== #}

        <div class="s-blocks-wrapper s-before-related">
            {% hook 'product.single.before_product_recommendations' %}
        </div>


        <section class="rawan-recommendations">

            {# =====================================================
               RAWAN TITLE
            ===================================================== #}

            <section class="rawan-section-heading rawan-section-heading--related">

                <div class="rawan-heading-line"></div>

                <div class="rawan-heading-content">

                    <span class="rawan-heading-kicker">
                        Rawan
                    </span>

                    <h2>
                        قد يعجبك أيضًا
                    </h2>

                    <span class="rawan-heading-dot"></span>

                </div>

                <div class="rawan-heading-line"></div>

            </section>


            {# =====================================================
               SALLA RELATED PRODUCTS

               هذا هو الجزء الذي يجلب المنتجات الفعلية.
            ===================================================== #}

            <div class="container rawan-related-products">

                <salla-products-slider
                    data-testid="store-product-related"
                    source="related"
                    source-value="{{ product.id }}"
                    display-all-url
                ></salla-products-slider>

            </div>

        </section>


        <div class="s-blocks-wrapper s-after-related">
            {% hook 'product.single.after_product_recommendations' %}
        </div>


    </main>

{% endblock %}


{# =============================================================
   SCRIPTS
============================================================= #}

{% block scripts %}

    <script
        defer
        src="{{ 'product.js' | asset }}"
    ></script>


    {% if product.has_3d_image %}

        <script
            type="module"
            defer
            src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"
        ></script>

    {% endif %}


    {% if product.digital_files_settings %}

        <script
            type="module"
            defer
            src="{{ 'digital-files.js'|asset }}"
        ></script>

    {% endif %}

{% endblock %}