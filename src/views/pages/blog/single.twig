{#
| Variable                | Type           | Description |
|-------------------------|----------------|-------------|
| article.title           | string         |             |
| article.body            | string *HTML   |             |
| article.url             | string         |             |
| article.has_image       | Bool           |             |
| article.image           | object         |             |
| article.image.url       | string         |             |
| article.image.alt       | string         |             |
| article.thumbnail       | string         |             |
| article.created_at      | ?Date *Carbon  |             |
| article.author.name     | string         |             |
| article.author.url      | string         |             |
| article.related         | Article[]      |             |
| article.tags            | BlogTag[]      |             |
| article.tags[].name     | string         |             |
| article.tags[].url      | string         |             |
#}

{% extends "layouts.master" %}

{% block content %}

<div class="rawan-blog-page">

    {# =========================================================
       BREADCRUMBS
    ========================================================== #}

    <div class="container">

        <nav class="rawan-blog-breadcrumbs">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>

    </div>


    {# =========================================================
       ARTICLE HERO
    ========================================================== #}

    <div class="container">

        <header class="rawan-article-hero">

            <div class="rawan-article-hero__badge">

                <span class="rawan-article-hero__dot"></span>

                <span>
                    مدونة روان
                </span>

            </div>


            <h1>
                {{ article.title }}
            </h1>


            <div class="rawan-article-meta">

                <div class="rawan-article-meta__item">

                    <span class="rawan-meta-icon">
                        <i class="sicon-calendar-date"></i>
                    </span>

                    <div>
                        <small>
                            تاريخ النشر
                        </small>

                        <strong>
                            {{ article.created_at|date }}
                        </strong>
                    </div>

                </div>


                <span class="rawan-meta-divider"></span>


                <a
                    href="{{ article.author.url }}"
                    class="rawan-article-meta__item rawan-author"
                >

                    <span class="rawan-meta-icon">
                        <i class="sicon-user"></i>
                    </span>

                    <div>
                        <small>
                            بقلم
                        </small>

                        <strong>
                            {{ article.author.name }}
                        </strong>
                    </div>

                </a>

            </div>

        </header>


        {# =========================================================
           MAIN LAYOUT
        ========================================================== #}

        <div class="rawan-article-layout">


            {# =====================================================
               ARTICLE
            ====================================================== #}

            <main class="rawan-article-card">


                {# =================================================
                   FEATURED IMAGE
                ================================================== #}

                {% if article.has_image %}

                    <div class="rawan-article-cover">

                        <img
                            src="{{ article.image.url }}"
                            alt="{{ article.image.alt }}"
                            title="{{ article.image.alt }}"
                            loading="eager"
                        >

                        <div class="rawan-article-cover__overlay"></div>

                        <div class="rawan-article-cover__label">

                            <span></span>

                            قراءة المقال

                        </div>

                    </div>

                {% endif %}


                {# =================================================
                   ARTICLE BODY WRAPPER
                ================================================== #}

                <div class="rawan-article-content">


                    {# =================================================
                       SOCIAL / ENGAGEMENT
                    ================================================== #}

                    {% if store.settings.blog.allow_likes_and_comments %}

                        <div class="rawan-article-engagement">

                            <div class="rawan-engagement-item">

                                <button
                                    id="blog-like"
                                    data-blog-id="{{ article.key }}"
                                    type="button"
                                    class="rawan-like-button"
                                    aria-label="إعجاب بالمقال"
                                >

                                    <span class="rawan-like-icon">
                                        <i class="sicon-thumbs-up"></i>
                                    </span>

                                    <span>
                                        إعجاب
                                    </span>

                                    <strong>
                                        {{ article.likes_count }}
                                    </strong>

                                </button>

                            </div>


                            {% if article.comments_count %}

                                <div class="rawan-engagement-item">

                                    <span class="rawan-comment-icon">
                                        <i class="sicon-chat"></i>
                                    </span>

                                    <span>
                                        التعليقات
                                    </span>

                                    <strong>
                                        {{ article.comments_count }}
                                    </strong>

                                </div>

                            {% endif %}

                        </div>

                    {% endif %}


                    {# =================================================
                       ARTICLE BODY
                    ================================================== #}

                    <article class="rawan-article-body">

                        {{ article.body|replace({'&nbsp;': ' '})|raw }}

                    </article>


                    {# =================================================
                       TAGS
                    ================================================== #}

                    {% if article.tags|length %}

                        <div class="rawan-article-tags">

                            <div class="rawan-tags-title">

                                <i class="sicon-tag"></i>

                                <span>
                                    التصنيفات
                                </span>

                            </div>


                            <div class="rawan-tags-list">

                                {% for tag in article.tags %}

                                    <a
                                        href="{{ tag.url }}"
                                        class="rawan-tag"
                                    >

                                        <span>
                                            {{ tag.name }}
                                        </span>

                                    </a>

                                {% endfor %}

                            </div>

                        </div>

                    {% endif %}


                    {# =================================================
                       AUTHOR FOOTER
                    ================================================== #}

                    <div class="rawan-article-author">

                        <div class="rawan-author-avatar">

                            <span>
                                {{ article.author.name|first }}
                            </span>

                        </div>


                        <div class="rawan-author-info">

                            <small>
                                كاتب المقال
                            </small>

                            <a href="{{ article.author.url }}">
                                {{ article.author.name }}
                            </a>

                        </div>


                        <div class="rawan-author-line"></div>

                        <div class="rawan-author-brand">
                            Rawan
                        </div>

                    </div>


                    {# =================================================
                       COMMENTS
                    ================================================== #}

                    {% if store.settings.blog.allow_likes_and_comments %}

                        <section class="rawan-comments">

                            <div class="rawan-comments-header">

                                <div>

                                    <span class="rawan-comments-kicker">
                                        شاركنا رأيك
                                    </span>

                                    <h2>
                                        التعليقات
                                    </h2>

                                </div>

                                <span class="rawan-comments-line"></span>

                            </div>


                            <salla-comments
                                data-testid="store-blog-comments"
                                item-id="{{ article.key }}"
                                type="blog"
                            ></salla-comments>

                        </section>

                    {% endif %}

                </div>

            </main>


            {# =====================================================
               SIDEBAR
            ====================================================== #}

            {% if related|length %}

                <aside
                    aria-label="مقالات ذات صلة"
                    class="rawan-article-sidebar"
                >


                    {# SIDEBAR HEADER #}

                    <div class="rawan-sidebar-heading">

                        <div>

                            <span>
                                اكتشف المزيد
                            </span>

                            <h2>
                                مقالات ذات صلة
                            </h2>

                        </div>

                        <i class="sicon-book"></i>

                    </div>


                    <div class="rawan-sidebar-line"></div>


                    {% hook 'blog:single.items.start' %}


                    {# RELATED ARTICLES #}

                    <div class="rawan-related-list">

                        {% for article in related %}

                            <article class="rawan-related-card">

                                <a
                                    href="{{ article.url }}"
                                    class="rawan-related-image"
                                >

                                    {% if article.has_image %}

                                        <img
                                            src="{{ article.image.url }}"
                                            alt="{{ article.image.alt }}"
                                            loading="lazy"
                                        >

                                    {% else %}

                                        <img
                                            src="{{ 'images/placeholder.png' | asset }}"
                                            alt="post image"
                                            loading="lazy"
                                        >

                                    {% endif %}


                                    <span class="rawan-related-number">
                                        {{ '%02d'|format(loop.index) }}
                                    </span>

                                </a>


                                <div class="rawan-related-content">

                                    <div class="rawan-related-date">

                                        <i class="sicon-calendar-date"></i>

                                        <time>
                                            {{ article.created_at|date }}
                                        </time>

                                    </div>


                                    <h3>

                                        <a href="{{ article.url }}">
                                            {{ article.title }}
                                        </a>

                                    </h3>


                                    <a
                                        href="{{ article.url }}"
                                        class="rawan-related-read"
                                    >

                                        <span>
                                            قراءة المقال
                                        </span>

                                        <i class="sicon-arrow-left"></i>

                                    </a>

                                </div>

                            </article>

                        {% endfor %}

                    </div>


                    {% hook 'blog:single.items.end' %}


                    {# SIDEBAR BRAND CARD #}

                    <div class="rawan-blog-brand-card">

                        <div class="rawan-blog-brand-card__ornament">
                            <span></span>
                            <i></i>
                            <span></span>
                        </div>

                        <span>
                            Rawan
                        </span>

                        <p>
                            تفاصيل صغيرة تصنع تجربة مختلفة.
                        </p>

                    </div>

                </aside>

            {% endif %}

        </div>

    </div>

</div>

{% endblock %}