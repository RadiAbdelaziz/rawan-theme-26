{% extends "layouts.master" %}

{% block content %}

<section class="luxury-category-page" dir="rtl">

    {# ================= HERO ================= #}

    <header class="luxury-category-hero">
    <h1>Radi abdelaziz musa babker ali</h1>
        <div class="luxury-category-hero__glow"></div>
        <div class="luxury-category-hero__glow luxury-category-hero__glow--second"></div>

        <div class="container mx-auto px-4">

            <div class="luxury-category-hero__content">

                <span class="luxury-category-hero__eyebrow">
                    مجموعتنا المختارة
                </span>

                <h1 class="luxury-category-hero__title">
                    {{ category.name ?: page.title }}
                </h1>

                {% if category.description %}

                    <p class="luxury-category-hero__description">
                        {{ category.description }}
                    </p>

                {% else %}

                    <p class="luxury-category-hero__description">
                        اكتشف تشكيلتنا المختارة بعناية،
                        حيث تلتقي الأناقة بالجودة في كل تفاصيل.
                    </p>

                {% endif %}

                <div class="luxury-category-divider">
                    <span></span>
                    <i></i>
                    <span></span>
                </div>

            </div>

        </div>

    </header>


    {# ================= PRODUCTS ================= #}

    <main class="luxury-category-products">

        <div class="container mx-auto px-4">

            {% if products|length > 0 %}

                <div class="luxury-products-header">

                    <div class="luxury-products-heading">

                        <span>
                            المجموعة
                        </span>

                        <h2>
                            منتجات {{ category.name ?: page.title }}
                        </h2>

                    </div>

                    <div class="luxury-products-count">
                        {{ products|length }}
                        <small>منتج</small>
                    </div>

                </div>


                <div class="luxury-products-grid">

                    {% for product in products %}

                        <article
                            class="luxury-product-item"
                            style="--product-index: {{ loop.index0 }};"
                        >

                            {% include 'components.products.card' with {
                                product: product
                            } %}

                        </article>

                    {% endfor %}

                </div>

            {% else %}

                <div class="luxury-category-empty">

                    <div class="luxury-category-empty__icon">
                        <i class="sicon-box"></i>
                    </div>

                    <span>
                        المجموعة فارغة
                    </span>

                    <h2>
                        لا توجد منتجات حالياً
                    </h2>

                    <p>
                        سيتم إضافة منتجات جديدة إلى هذا التصنيف قريباً.
                    </p>

                    <a href="{{ link('/') }}">
                        العودة إلى الرئيسية
                    </a>

                </div>

            {% endif %}

        </div>

    </main>

</section>

{% endblock %}
